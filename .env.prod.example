# --- Image & Network ---
REGISTRY_PREFIX=ghcr.io/npv2k1/memory-lab
IMAGE_TAG=main
WEB_BIND=0.0.0.0
WEB_PORT=4321

# --- Embedding Provider (OpenAI-compatible: OpenAI, OpenRouter, Ollama, vLLM) ---
# Có thể để trống EMBEDDING_MODEL nếu chỉ dùng sparse (BM25), graph hoặc zero_token.
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Memory & Security ---
DEFAULT_MEMORY_STRATEGY=hybrid
QDRANT_COLLECTION=documents
CORS_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321"]
MAX_UPLOAD_BYTES=52428800

# --- Optional: Neo4j Graph Store (chạy cùng: docker compose -f docker-compose.prod.yml --profile graph up -d) ---
NEO4J_URL=
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-production
NEO4J_DATABASE=neo4j

# --- Optional: Automatic HTTPS TLS via Caddy (chạy cùng: --profile tls) ---
# DOMAIN=memory.example.com
