{
  "id": null,
  "uid": "memory-lab-enterprise",
  "title": "Memory Lab Enterprise SaaS Overview",
  "tags": ["memory-lab", "enterprise", "saas"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Tenants",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "max(memory_lab_tenants_total)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Async Jobs Queued",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "max(memory_lab_jobs_queued)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Async Jobs Completed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "max(memory_lab_jobs_completed)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate Limited Requests",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(memory_lab_rate_limited_total) or vector(0)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s by path)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (path) (rate(memory_lab_http_requests_total[1m]))", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Average API Latency (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (path) (rate(memory_lab_http_request_duration_seconds_sum[5m])) / clamp_min(sum by (path) (rate(memory_lab_http_request_duration_seconds_count[5m])), 0.001)",
          "refId": "A"
        }
      ]
    }
  ]
}
