# --- Domain & Edge Proxy ---
# Đổi SITE_ADDRESS=memory.yourdomain.com để Caddy tự cấp chứng chỉ HTTPS Let's Encrypt
SITE_ADDRESS=:8080
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Horizontal Scaling ---
API_REPLICAS=2
WORKER_REPLICAS=2
WEB_REPLICAS=2
UVICORN_WORKERS=2

# --- Enterprise Authentication & Security (BẮT BUỘC ĐỔI KHI LÊN PROD) ---
AUTH_MODE=enterprise
JWT_SECRET=replace-with-openssl-rand-hex-32-enterprise-secret
ADMIN_BOOTSTRAP_KEY=replace-with-strong-bootstrap-admin-key
RATE_LIMIT_RPM=600
CORS_ORIGINS=["http://localhost:8080","https://memory.yourdomain.com"]

# --- Embedding Provider (OpenAI, OpenRouter, Ollama, vLLM) ---
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
DEFAULT_MEMORY_STRATEGY=hybrid

# --- Stateful Backends ---
POSTGRES_USER=memorylab
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=memorylab
REDIS_MAXMEMORY=512mb
NEO4J_PASSWORD=replace-with-strong-neo4j-password
NEO4J_HEAP_INIT=512m
NEO4J_HEAP_MAX=2G
MINIO_ROOT_USER=memorylab
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
S3_BUCKET=memory-lab

# --- Observability ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
