async function refreshMemory() {
  const [records, temporal, graph] = await Promise.all([
    request('/memory/records?limit=50'),
    request('/memory/temporal'),
    request('/memory/graph' + (input('graph-entity-filter').value ? `?entity=${encodeURIComponent(input('graph-entity-filter').value)}` : '')),
  ]);

  el('mem-record-count').textContent = String(records.length);
  el('mem-records').replaceChildren();
  for (const rec of records) {
    const row = document.createElement('article');
    const p = document.createElement('p');
    p.textContent = rec.summary || rec.content;
    const meta = document.createElement('div');
    meta.className = 'meta';
    meta.append(pill(rec.strategy, 'accent'), pill(`session:${rec.session_id}`), pill(rec.timestamp.slice(0, 10)));
    if (rec.entities?.length) {
      meta.append(pill(`entities:${rec.entities.map((e: any) => e.name).slice(0, 3).join(', ')}`));
    }
    const controls = document.createElement('div');
    controls.className = 'controls';
    controls.append(
      button('Delete', async () => {
        await request(`/memory/records/${rec.id}`, { method: 'DELETE' });
        await Promise.all([refreshMemory(), refreshOverview()]);
      }, 'danger sm')
    );
    row.append(p, meta, controls);
    el('mem-records').append(row);
  }

  el('mem-temporal').textContent = JSON.stringify(temporal, null, 2);
  el('mem-graph').textContent = JSON.stringify(graph, null, 2);
}

// --- TAB 4: Experimentation & Comparison ---
async function refreshExperiments() {
  const [datasets, reports] = await Promise.all([
    request('/experiments/datasets'),
    request('/experiments/reports'),
  ]);

  el('exp-datasets').replaceChildren();
  const dsSelect = select('exp-run-dataset');
  const prevSelected = dsSelect.value;
  dsSelect.replaceChildren();
  for (const ds of datasets) {
    const row = document.createElement('article');
    const p = document.createElement('p');
    p.textContent = `${ds.name} (${ds.cases.length} cases)`;
    const meta = document.createElement('div');
    meta.className = 'meta';
    meta.append(pill(`id:${ds.id}`), pill(`hash:${ds.dataset_hash.slice(0, 10)}`, 'accent'));
    row.append(p, meta);
    el('exp-datasets').append(row);

    const opt = document.createElement('option');
    opt.value = ds.id;
    opt.textContent = `${ds.name} (${ds.id})`;
    dsSelect.append(opt);
  }
  if (prevSelected) dsSelect.value = prevSelected;

  el('exp-reports').replaceChildren();
  for (const rep of reports) {
    const row = document.createElement('article');
    const label = document.createElement('label');
    const cb = document.createElement('input');
    cb.type = 'checkbox';
    cb.className = 'report-check';
    cb.value = rep.id;
    cb.checked = true;
    const title = document.createElement('strong');
    title.textContent = `${rep.name} [${rep.target}]`;
    label.append(cb, title);
    const meta = document.createElement('div');
    meta.className = 'meta';
    meta.append(
      pill(`Recall@${rep.k}: ${rep.metrics.recall_at_k.toFixed(3)}`, 'accent'),
      pill(`MRR: ${rep.metrics.mrr.toFixed(3)}`),
      pill(`nDCG@${rep.k}: ${rep.metrics.ndcg_at_k.toFixed(3)}`),
      pill(`${rep.metrics.avg_latency_ms.toFixed(1)} ms`)
    );
    row.append(label, meta);
    el('exp-reports').append(row);
  }
}

function renderComparison(comparison: any) {
  const wrap = el('exp-comparison');
  wrap.replaceChildren();
  const info = document.createElement('p');
  info.className = 'hint';
  info.textContent = `Baseline: ${comparison.baseline_id} · Dataset hash match: ${comparison.same_dataset_hash ? 'YES' : 'DIFFERS'}`;
  wrap.append(info);

  const tableWrap = document.createElement('div');
  tableWrap.className = 'table-wrap';
  const table = document.createElement('table');
  const thead = document.createElement('thead');
  const htr = document.createElement('tr');
  for (const label of ['Run', 'Target / Config', 'Dataset Hash', 'Recall@K', 'MRR', 'nDCG@K', 'Latency (ms)']) {
    const th = document.createElement('th');
    th.textContent = label;
    htr.append(th);
  }
  thead.append(htr);

  const tbody = document.createElement('tbody');
  for (const row of comparison.reports) {
    const tr = document.createElement('tr');
    const cfg = row.target === 'documents'
      ? `docs · ${row.config_snapshot.search_mode}`
      : `memory · ${row.config_snapshot.resolved_memory_strategy}`;

    const tdName = document.createElement('td');
    const strong = document.createElement('strong');
    strong.textContent = row.name;
    const br = document.createElement('br');
    const small = document.createElement('small');
    small.textContent = row.id;
    tdName.append(strong, br, small);

    const tdCfg = document.createElement('td');
    tdCfg.append(pill(cfg));

    const tdHash = document.createElement('td');
    const code = document.createElement('code');
    code.textContent = row.dataset_hash.slice(0, 10);
    tdHash.append(code);

    tr.append(tdName, tdCfg, tdHash);

    for (const metric of ['recall_at_k', 'mrr', 'ndcg_at_k']) {
      const td = document.createElement('td');
      const val = Number(row.metrics[metric]).toFixed(3);
      const delta = Number(row.delta_vs_baseline[metric]);
      td.append(val);
      if (delta !== 0) {
        const span = document.createElement('span');
        span.className = delta > 0 ? 'delta-pos' : 'delta-neg';
        span.textContent = ` (${delta > 0 ? '+' : ''}${delta.toFixed(3)})`;
        td.append(span);
      }
      tr.append(td);
    }

    const tdLat = document.createElement('td');
    tdLat.textContent = row.metrics.avg_latency_ms.toFixed(2);
    tr.append(tdLat);
    tbody.append(tr);
  }
  table.append(thead, tbody);
  tableWrap.append(table);
  wrap.append(tableWrap);
}

