    ]);
    docsCache = docs || [];
    memoriesCache = mems || [];

    $('nav-badge-docs').textContent = String(docsCache.length);
    $('nav-badge-memory').textContent = String(memoriesCache.length);

    // Populate Ask document & time filters
    const docSel = $select('ask-doc-filter');
    const prevDoc = docSel.value;
    docSel.innerHTML =
      `<option value="">Tài liệu: Tất cả</option>` +
      docsCache.map((d) => `<option value="${esc(d.id)}">${esc(d.filename)}</option>`).join('');
    if (prevDoc) docSel.value = prevDoc;

    const months = Array.from(
      new Set(memoriesCache.map((m) => String(m.timestamp || '').slice(0, 7)).filter((s) => /^\d{4}-\d{2}$/.test(s)))
    ).sort((a, b) => b.localeCompare(a));
    const timeSel = $select('ask-time-filter');
    const prevTime = timeSel.value;
    timeSel.innerHTML =
      `<option value="">Thời gian: Tất cả</option>` +
      months.map((m) => `<option value="${esc(m)}">Tháng ${m.slice(5)}/${m.slice(0, 4)}</option>`).join('');
    if (prevTime) timeSel.value = prevTime;

    renderAskRecent();
  } catch {}
}

function renderAskRecent() {
  const recentDocsEl = $('ask-recent-docs');
  if (!docsCache.length) {
    recentDocsEl.innerHTML = `
      <div class="card card-pad" style="text-align:center;color:var(--ink-muted);font-size:13px;">
        Chưa có tài liệu nào. <button type="button" class="btn btn-ghost btn-sm" id="btn-empty-upload-doc" style="color:var(--accent);">Tải tài liệu lên →</button>
      </div>
    `;
    $('btn-empty-upload-doc')?.addEventListener('click', () => switchScreen('docs'));
  } else {
    recentDocsEl.innerHTML = docsCache
      .slice(0, 4)
      .map((d) => {
        const chunks = d.latest_run?.chunk_count || 0;
        const st = d.latest_run?.status === 'completed' ? `${chunks} đoạn · Sẵn sàng` : d.latest_run?.status === 'processing' ? 'Đang xử lý…' : 'Chưa xử lý';
        return `
          <button type="button" class="recent-item" data-open-doc="${esc(d.id)}" data-open-ver="${esc(d.version)}">
            <div style="min-width:0;">
              <div class="recent-item-title">📄 ${esc(d.filename)}</div>
              <div class="recent-item-meta">${esc(st)} ${d.updated_ts ? '· ' + formatRelativeTime(d.updated_ts) : ''}</div>
            </div>
            <span class="doc-ext">${esc(d.extension || 'txt')}</span>
          </button>
        `;
      })
      .join('');
    recentDocsEl.querySelectorAll<HTMLButtonElement>('[data-open-doc]').forEach((btn) => {
      btn.addEventListener('click', () => {
        switchScreen('docs');
        openDocumentDetail(btn.dataset.openDoc!, btn.dataset.openVer!);
      });
    });
  }

  const recentMemEl = $('ask-recent-memories');
  if (!memoriesCache.length) {
    recentMemEl.innerHTML = `
      <div class="card card-pad" style="text-align:center;color:var(--ink-muted);font-size:13px;">
        Chưa có ký ức nào. <button type="button" class="btn btn-ghost btn-sm" id="btn-empty-add-mem" style="color:var(--accent);">Ghi nhớ điều đầu tiên →</button>
      </div>
    `;
    $('btn-empty-add-mem')?.addEventListener('click', () => switchScreen('memory'));
  } else {
    recentMemEl.innerHTML = memoriesCache
      .slice(0, 4)
      .map((m) => {
        const preview = String(m.content || '').length > 110 ? String(m.content).slice(0, 108) + '…' : String(m.content || '');
        return `
          <button type="button" class="recent-item" data-open-mem="${esc(m.id)}">
            <div style="min-width:0;">
              <div class="recent-item-title">🧠 ${esc(preview)}</div>
              <div class="recent-item-meta">${esc(m.session_id || 'default')} · ${formatRelativeTime(m.timestamp)}</div>
            </div>
          </button>
        `;
      })
      .join('');
    recentMemEl.querySelectorAll<HTMLButtonElement>('[data-open-mem]').forEach((btn) => {
      btn.addEventListener('click', () => switchScreen('memory'));
    });
  }
}

async function runAskSearch() {
  const q = $input('ask-input').value.trim();
  if (!q) {
    clearAskResults();
    return;
  }

  const params = new URLSearchParams({
    q,
    scope: askScope,
    doc_mode: devMode ? $select('ask-dev-doc-mode').value : 'hybrid',
    memory_strategy: devMode ? $select('ask-dev-mem-strategy').value : 'hybrid',
    limit: '15',
  });
  const docId = $select('ask-doc-filter').value;
  if (docId) params.set('document_id', docId);
  const tb = $select('ask-time-filter').value;
  if (tb) params.set('temporal_bucket', tb);

  $('ask-hero').classList.add('has-results');
  $('ask-idle').hidden = true;
  $('ask-results-wrap').hidden = false;
  $('ask-results-summary').textContent = 'Đang tìm kiếm…';
  $('ask-results-list').innerHTML = '';

  try {
    const data = await apiFetch(`/knowledge/search?${params.toString()}`);
    askLastResults = data;
    renderAskResults(data, q);
  } catch (err: any) {
    $('ask-results-summary').textContent = `Không thể tìm kiếm: ${err.message}`;
  }
}

function clearAskResults() {
  $input('ask-input').value = '';
  askLastResults = null;
  askSelectedKey = '';
  $('ask-hero').classList.remove('has-results');
  $('ask-results-wrap').hidden = true;
  $('ask-idle').hidden = false;
  closeDrawer();
}

function renderAskResults(data: any, query: string) {
  const unified: any[] = [];
  for (const d of data.documents || []) {
    unified.push({ kind: 'document', key: `doc:${d.chunk.id}`, score: Number(d.score || 0), raw: d });
  }
  for (const m of data.memories || []) {
    unified.push({ kind: 'memory', key: `mem:${m.record.id}`, score: Number(m.score || 0), raw: m });
  }
  unified.sort((a, b) => b.score - a.score);

  const summary = $('ask-results-summary');
  const list = $('ask-results-list');

  if (!unified.length) {
    summary.textContent = `0 kết quả cho “${query}”`;
    list.innerHTML = `
      <div class="card empty-state">
        <div class="empty-title">Không tìm thấy kết quả phù hợp</div>
        <p class="empty-sub">Thử từ khóa ngắn hơn, bỏ bộ lọc thời gian/tài liệu, hoặc tải thêm tài liệu mới.</p>
      </div>
    `;
    return;
  }

  summary.textContent = `Tìm thấy ${unified.length} kết quả liên quan (${data.latency_ms} ms)`;
  const maxScore = Math.max(...unified.map((u) => u.score), 0.001);

  list.innerHTML = unified
    .map((item) => {
      if (item.kind === 'document') {
        const d = item.raw;
        const metaParts = [d.filename];
        if (d.heading) metaParts.push(d.heading);
        if (d.page != null) metaParts.push(`Trang ${d.page}`);
        const text = String(d.chunk.text || '');
        const snippet = text.length > 320 ? text.slice(0, 318) + '…' : text;
        const ents = (d.entities || [])
          .slice(0, 5)
          .map((e: any) => `<span class="tag-pill">${esc(e.name)}</span>`)
          .join('');
        return `
          <button type="button" class="result-card ${askSelectedKey === item.key ? 'is-selected' : ''}" data-res-key="${esc(item.key)}">
            <div class="result-top">
              <span class="result-source"><span class="source-icon-doc">📄</span> ${esc(metaParts.join(' · '))}</span>
              ${relevanceBarsHtml(item.score, maxScore)}
            </div>
            <p class="result-excerpt">${highlightText(snippet, query)}</p>
            ${ents ? `<div class="result-footer">${ents}</div>` : ''}
          </button>
        `;
      } else {
        const m = item.raw;
        const rec = m.record;
        const dateLabel = String(rec.timestamp || '').slice(0, 10);
        const text = String(rec.content || '');
        const snippet = text.length > 320 ? text.slice(0, 318) + '…' : text;
        const ents = (rec.entities || [])
          .slice(0, 5)
          .map((e: any) => `<span class="tag-pill">${esc(e.name)}</span>`)
          .join('');
        return `
          <button type="button" class="result-card ${askSelectedKey === item.key ? 'is-selected' : ''}" data-res-key="${esc(item.key)}">
            <div class="result-top">
              <span class="result-source"><span class="source-icon-mem">🧠</span> Ký ức · ${esc(dateLabel)} · ${esc(rec.session_id || 'default')}</span>
              ${relevanceBarsHtml(item.score, maxScore)}
            </div>
            <p class="result-excerpt">${highlightText(snippet, query)}</p>
            ${ents ? `<div class="result-footer">${ents}</div>` : ''}
          </button>
        `;
      }
    })
    .join('');

  list.querySelectorAll<HTMLButtonElement>('.result-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.resKey!;
      askSelectedKey = key;
      list.querySelectorAll('.result-card').forEach((c) => c.classList.toggle('is-selected', (c as HTMLElement).dataset.resKey === key));
      const found = unified.find((u) => u.key === key);
      if (found) openReadingDrawer(found, query);
    });
  });
}

function openReadingDrawer(item: any, query: string) {
  const titleEl = $('drawer-title');
  const subEl = $('drawer-subtitle');
  const bodyEl = $('drawer-body');

  if (item.kind === 'document') {
    const d = item.raw;
    titleEl.textContent = d.filename;
    const subParts: string[] = [];
    if (d.heading) subParts.push(d.heading);
    if (d.page != null) subParts.push(`Trang ${d.page}`);
    if (d.chunk_index != null) subParts.push(`Đoạn #${d.chunk_index + 1}`);
    subEl.textContent = subParts.join(' · ') || 'Đoạn trích từ tài liệu';

    const prevHtml = d.adjacent?.prev_text
      ? `<div class="drawer-adjacent"><div class="drawer-adjacent-label">Đoạn trước</div>${esc(d.adjacent.prev_text)}</div>`
      : '';
    const nextHtml = d.adjacent?.next_text
      ? `<div class="drawer-adjacent"><div class="drawer-adjacent-label">Đoạn tiếp theo</div>${esc(d.adjacent.next_text)}</div>`
      : '';
    const entHtml = (d.entities || []).length
      ? `<div>
           <div class="aside-title">Thực thể trong đoạn</div>
           <div style="display:flex;flex-wrap:wrap;gap:6px;">
             ${d.entities.map((e: any) => `<button type="button" class="entity-chip" data-jump-entity="${esc(e.id)}">${esc(e.name)}</button>`).join('')}
           </div>
         </div>`
      : '';

    bodyEl.innerHTML = `
      ${prevHtml}
      <div class="drawer-passage">${highlightText(d.chunk.text, query)}</div>
      ${nextHtml}
      ${entHtml}
      <div style="display:flex;gap:8px;padding-top:10px;border-top:1px solid var(--border);">
        <button type="button" class="btn btn-primary btn-sm" id="btn-drawer-open-doc">Đọc toàn bộ tài liệu</button>
        <a class="btn btn-sm" href="${esc(apiBase() + d.source_url)}" download>Tải tệp gốc</a>
      </div>
    `;
    $('btn-drawer-open-doc')?.addEventListener('click', () => {
      closeDrawer();
      switchScreen('docs');
      openDocumentDetail(d.chunk.document_id, d.chunk.version);
    });
  } else {
    const rec = item.raw.record;
    titleEl.textContent = `Ký ức · ${String(rec.timestamp || '').slice(0, 10)}`;
    subEl.textContent = `Phiên: ${rec.session_id || 'default'}`;
    const entHtml = (rec.entities || []).length
      ? `<div>
           <div class="aside-title">Thực thể liên quan</div>
           <div style="display:flex;flex-wrap:wrap;gap:6px;">
             ${rec.entities.map((e: any) => `<button type="button" class="entity-chip" data-jump-entity="${esc(e.normalized_name || e.name)}">${esc(e.name)}</button>`).join('')}
           </div>
         </div>`
      : '';
    const tagsHtml = (rec.tags || []).length
      ? `<div style="display:flex;flex-wrap:wrap;gap:6px;">${rec.tags.map((t: string) => `<span class="tag-pill">#${esc(t)}</span>`).join('')}</div>`
      : '';

    bodyEl.innerHTML = `
      <div class="drawer-passage">${highlightText(rec.content, query)}</div>
      ${tagsHtml}
      ${entHtml}
      <div style="padding-top:10px;border-top:1px solid var(--border);">
        <button type="button" class="btn btn-sm" id="btn-drawer-open-mem">Xem trong dòng thời gian Ký ức</button>
      </div>
    `;
    $('btn-drawer-open-mem')?.addEventListener('click', () => {
      closeDrawer();
      switchScreen('memory');
    });
  }

  bodyEl.querySelectorAll<HTMLButtonElement>('[data-jump-entity]').forEach((btn) => {
    btn.addEventListener('click', () => jumpToEntityEgoGraph(btn.dataset.jumpEntity!));
  });

  $('drawer-backdrop').hidden = false;
  $('reading-drawer').hidden = false;
}

function closeDrawer() {
  $('drawer-backdrop').hidden = true;
  $('reading-drawer').hidden = true;
}

// ==================== SCREEN 2: TÀI LIỆU ====================

async function loadDocuments() {
  try {
    docsCache = await apiFetch('/documents');
    $('nav-badge-docs').textContent = String(docsCache.length);
    renderDocumentsList();
    // Auto-watch any currently processing runs
    for (const d of docsCache) {
      if (d.latest_run?.status === 'processing' && d.latest_run.pipeline_run_id) {
        watchRunProgress(d.latest_run.pipeline_run_id, d.id, d.version);
      }
    }
  } catch (err: any) {
    $('docs-list').innerHTML = `<div class="card empty-state"><div class="empty-title">Không thể tải danh sách tài liệu</div><p class="empty-sub">${esc(err.message)}</p></div>`;
  }
}

function renderStatusHtml(run: any): string {
  if (!run) return `<span class="status-pill status-pending">Chưa xử lý</span>`;
  if (run.status === 'completed') return `<span class="status-pill status-ready">✓ Sẵn sàng</span>`;
  if (run.status === 'processing') {
    const pct = Number(run.progress || 10);
    return `<span class="status-pill status-processing">⟳ Đang xử lý · ${pct}%</span>`;
  }
  if (run.status === 'failed') {
    const reason = run.error_message || run.error_type || 'Lỗi xử lý';
    return `<span class="status-pill status-error" title="${esc(reason)}">⚠ Lỗi</span>`;
  }
  return `<span class="status-pill status-pending">Cần xử lý lại</span>`;
}

function renderFiveStepBar(run: any): string {
  const stages = run.stages || {};
  const pct = Number(run.progress || 10);
  return `
    <div class="doc-progress-wrap" data-progress-run="${esc(run.pipeline_run_id)}">
      <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--ink-secondary);">
        <span>Đang xử lý tài liệu…</span>
        <strong>${pct}%</strong>
      </div>
      <div class="steps-5">
        ${STAGE_ORDER.map((s) => {
          const st = stages[s.key] || 'pending';
          const cls = st === 'completed' ? 'is-done' : st === 'running' ? 'is-running' : '';
          return `
            <div class="step-item ${cls}">
              <div class="step-bar"></div>
              <span class="step-label">${s.label}</span>
            </div>
          `;
        }).join('')}
      </div>
    </div>
  `;
}

function renderDocumentsList() {
  const wrap = $('docs-list');
  if (!docsCache.length) {
    wrap.innerHTML = `
      <div class="card empty-state">
        <div class="empty-title">Chưa có tài liệu nào</div>
        <p class="empty-sub">Kéo thả tệp PDF, DOCX, Markdown hoặc TXT vào khung phía trên để bắt đầu xây dựng kho tri thức.</p>
      </div>
    `;
    return;
  }

  wrap.innerHTML = docsCache
    .map((d) => {
      const run = d.latest_run;
      const chunksLabel = run?.chunk_count ? `${run.chunk_count} đoạn` : formatBytes(d.size_bytes);
      const updated = formatRelativeTime(run?.updated_at || d.updated_ts);
      const errDetail =
        run?.status === 'failed' && run.error_message
          ? `<div style="font-size:12px;color:var(--danger);margin-top:4px;">Lý do: ${esc(run.error_message)}</div>`
          : '';
      const progressBar = run?.status === 'processing' ? renderFiveStepBar(run) : '';

      return `
        <div class="doc-row" data-doc-row="${esc(d.id)}:${esc(d.version)}">
          <div class="doc-main" data-open-detail="${esc(d.id)}" data-open-ver="${esc(d.version)}">
            <div class="doc-name-line">
              <span class="doc-ext">${esc(d.extension || 'txt')}</span>
              <span class="doc-filename">${esc(d.filename)}</span>
            </div>
            <div class="doc-meta-line">${esc(chunksLabel)} ${updated ? '· Cập nhật ' + esc(updated) : ''}</div>
            ${errDetail}
          </div>

          <div data-status-slot="${esc(d.id)}:${esc(d.version)}">${renderStatusHtml(run)}</div>

          <div class="doc-menu-wrap">
            <button type="button" class="btn btn-ghost btn-icon" data-toggle-menu="${esc(d.id)}:${esc(d.version)}" aria-label="Thao tác">⋯</button>
            <div class="doc-menu" data-menu-panel="${esc(d.id)}:${esc(d.version)}" hidden>
              <button type="button" data-doc-reprocess="${esc(d.id)}" data-doc-ver="${esc(d.version)}" data-doc-name="${esc(d.filename)}">Xử lý lại</button>
              <button type="button" data-doc-reprocess-opts="${esc(d.id)}" data-doc-ver="${esc(d.version)}" data-doc-name="${esc(d.filename)}">Xử lý lại với tuỳ chọn…</button>
              <a href="${esc(apiBase())}/documents/${esc(d.id)}/versions/${esc(d.version)}/source" download="${esc(d.filename)}">Tải xuống</a>
              <button type="button" class="is-danger" data-doc-delete="${esc(d.id)}" data-doc-name="${esc(d.filename)}">Xoá tài liệu</button>
            </div>
          </div>

          ${progressBar}
        </div>
      `;
    })
    .join('');

  // Wire row interactions
  wrap.querySelectorAll<HTMLElement>('[data-open-detail]').forEach((el) => {
    el.addEventListener('click', () => openDocumentDetail(el.dataset.openDetail!, el.dataset.openVer!));
  });

  wrap.querySelectorAll<HTMLButtonElement>('[data-toggle-menu]').forEach((btn) => {
    btn.addEventListener('click', (ev) => {
      ev.stopPropagation();
      const key = btn.dataset.toggleMenu!;
      wrap.querySelectorAll<HTMLElement>('.doc-menu').forEach((m) => {
        if (m.dataset.menuPanel !== key) m.hidden = true;
      });
      const target = wrap.querySelector<HTMLElement>(`.doc-menu[data-menu-panel="${CSS.escape(key)}"]`);
      if (target) target.hidden = !target.hidden;
    });
  });

  wrap.querySelectorAll<HTMLButtonElement>('[data-doc-reprocess]').forEach((btn) => {
    btn.addEventListener('click', () => {
      closeAllDocMenus();
      triggerBackgroundProcess(btn.dataset.docReprocess!, btn.dataset.docVer!, btn.dataset.docName!, defaultPipelineConfigFor(btn.dataset.docName!));
    });
  });

  wrap.querySelectorAll<HTMLButtonElement>('[data-doc-reprocess-opts]').forEach((btn) => {
    btn.addEventListener('click', () => {
      closeAllDocMenus();
      openReprocessModal(btn.dataset.docReprocessOpts!, btn.dataset.docVer!, btn.dataset.docName!);
    });
  });

  wrap.querySelectorAll<HTMLButtonElement>('[data-doc-delete]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      closeAllDocMenus();
      const name = btn.dataset.docName!;
      if (!confirm(`Xoá tài liệu “${name}” cùng toàn bộ dữ liệu chỉ mục?`)) return;
      try {
        await apiFetch(`/documents/${encodeURIComponent(btn.dataset.docDelete!)}`, { method: 'DELETE' });
        toast(`Đã xoá “${name}”`, 'ok');
        await loadDocuments();
      } catch (err: any) {
        toast(`Không thể xoá: ${err.message}`, 'err');
      }
    });
  });
}

function closeAllDocMenus() {
  document.querySelectorAll<HTMLElement>('.doc-menu').forEach((m) => (m.hidden = true));
}

async function uploadAndAutoProcessFiles(files: FileList | File[]) {
  const list = Array.from(files);
  if (!list.length) return;
  for (const file of list) {
    try {
      const form = new FormData();
      form.append('file', file);
      toast(`Đang tải lên “${file.name}”…`);
      const doc = await apiFetch('/documents', { method: 'POST', body: form });
      await loadDocuments();
      await triggerBackgroundProcess(doc.id, doc.version, doc.filename, defaultPipelineConfigFor(doc.filename));
    } catch (err: any) {
      toast(`Lỗi tải lên “${file.name}”: ${err.message}`, 'err');
    }
  }
}

async function triggerBackgroundProcess(docId: string, version: string, filename: string, config: any) {
  try {
    const manifest = await apiFetch(
      `/documents/${encodeURIComponent(docId)}/versions/${encodeURIComponent(version)}/process?background=true`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(config),
      }
    );
    toast(`Đang xử lý “${filename}” trong nền…`);
    await loadDocuments();
    if (manifest?.pipeline_run_id) {
      watchRunProgress(manifest.pipeline_run_id, docId, version);
    }
  } catch (err: any) {
    toast(`Lỗi xử lý “${filename}”: ${err.message}`, 'err');
  }
}

function watchRunProgress(runId: string, docId: string, version: string) {
  if (activeRunWatchers.has(runId)) return;

  const updateRowFromManifest = (manifest: any) => {
    const doc = docsCache.find((d) => d.id === docId && d.version === version);
    if (doc) {
      doc.latest_run = {
        ...(doc.latest_run || {}),
        pipeline_run_id: manifest.pipeline_run_id,
        status: manifest.status,
        progress: manifest.progress,
        current_stage: manifest.current_stage,
        stages: manifest.stages,
        chunk_count: manifest.chunk_count ?? doc.latest_run?.chunk_count ?? 0,
        error_message: manifest.error_message,
      };
      if (activeScreen === 'docs' && !$('docs-list-view').hidden) {
        renderDocumentsList();
      }
    }
  };

  const finish = async (manifest: any) => {
    const stop = activeRunWatchers.get(runId);
    if (stop) stop();
    activeRunWatchers.delete(runId);
    await loadDocuments();
    if (manifest.status === 'completed') {
      toast('Xử lý tài liệu hoàn tất!', 'ok');
    } else if (manifest.status === 'failed') {
      toast(`Xử lý thất bại: ${manifest.error_message || 'Lỗi không xác định'}`, 'err');
    }
  };

  // EventSource cannot send custom API key headers — use SSE when no custom headers are required, else poll cleanly.
  const hasCustomHeaders = Object.keys(authHeaders()).length > 0;
  if (!hasCustomHeaders && typeof EventSource !== 'undefined') {
    const es = new EventSource(`${apiBase()}/runs/${encodeURIComponent(runId)}/events`);
    const stop = () => es.close();
    activeRunWatchers.set(runId, stop);
    es.onmessage = (ev) => {
      try {
        const manifest = JSON.parse(ev.data);
        updateRowFromManifest(manifest);
        if (manifest.status === 'completed' || manifest.status === 'failed' || manifest.status === 'invalidated') {
          finish(manifest);
        }
      } catch {}
    };
    es.onerror = () => {
      es.close();
      activeRunWatchers.delete(runId);
      // Fallback one-shot refresh
      loadDocuments();
    };
  } else {
    let stopped = false;
    activeRunWatchers.set(runId, () => {
      stopped = true;
    });
    (async () => {
      for (let i = 0; i < 180 && !stopped; i++) {
        try {
          const manifest = await apiFetch(`/runs/${encodeURIComponent(runId)}/manifest`);
          updateRowFromManifest(manifest);
          if (manifest.status === 'completed' || manifest.status === 'failed' || manifest.status === 'invalidated') {
            await finish(manifest);
            return;
          }
        } catch {
          break;
        }
        await new Promise((r) => setTimeout(r, 450));
      }
      activeRunWatchers.delete(runId);
    })();
  }
}

async function openDocumentDetail(docId: string, version: string) {
