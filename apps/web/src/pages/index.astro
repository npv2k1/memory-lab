async function loadEgoGraph(entityId: string, depth: number) {
  const cleanId = entityId.trim();
  if (!cleanId) return;
  egoCurrentEntity = cleanId;
  egoDepth = depth;

  const btnDepth = $('btn-ego-depth');
  btnDepth.dataset.depth = String(depth);
  btnDepth.textContent = depth >= 2 ? 'Thu gọn bước 1' : 'Mở rộng bước 2';
  btnDepth.classList.toggle('btn-primary', depth >= 2);

  const includeCooccur = $input('ego-show-cooccur').checked;
  const entityType = $select('ego-type-filter').value;

  const params = new URLSearchParams({
    depth: String(depth),
    limit: '15',
    include_cooccurrence: String(includeCooccur),
    min_cooccurrence: '3',
  });
  if (entityType) params.set('entity_type', entityType);

  try {
    const data: EgoGraphPayload = await apiFetch(`/entities/${encodeURIComponent(cleanId)}/neighbors?${params.toString()}`);
    egoPayloadCache = data;
    $input('ego-entity-input').value = data.center.name;

    const coLabel = $('ego-cooccur-label');
    coLabel.textContent =
      data.hidden_cooccurrence_count > 0
        ? `Hiện thêm ${data.hidden_cooccurrence_count} liên kết cùng ngữ cảnh (≥ 3 lần)`
        : 'Hiện liên kết cùng ngữ cảnh (≥ 3 lần)';

    if (!egoRenderer) {
      egoRenderer = new EgoGraphRenderer(
        $('ego-stage'),
        $('ego-tooltip'),
        (eid) => loadEgoGraph(eid, 1),
        (node) => renderEgoInspector(egoPayloadCache, node)
      );
    }
    egoRenderer.render(data);
    renderEgoInspector(data, data.center);
  } catch (err: any) {
    $('ego-stage').innerHTML = `
      <div class="empty-state" style="padding-top:150px;">
        <div class="empty-title">Không tìm thấy thực thể “${esc(cleanId)}”</div>
        <p class="empty-sub">Hãy chọn một thực thể từ danh sách gợi ý hoặc từ Bảng thực thể.</p>
      </div>
    `;
  }
}

function renderEgoInspector(data: EgoGraphPayload | null, node: EgoNode) {
  const box = $('ego-inspector');
  if (!data) return;
  const meta = ENTITY_TYPE_META[node.type] || ENTITY_TYPE_META.concept;
  const nodeMap = new Map(data.nodes.map((n) => [n.id, n]));
  const rels = data.edges.filter((e) => e.source === node.id || e.target === node.id);

  const relsHtml = rels.length
    ? rels
        .map((e) => {
          const isOut = e.source === node.id;
          const other = nodeMap.get(isOut ? e.target : e.source);
          return `
            <div class="topic-chunk-card">
              <div style="font-size:13px;">
                <strong>${esc(isOut ? node.name : other?.name || e.source)}</strong>
                <span style="color:var(--accent);font-weight:600;"> ${esc(e.predicate_label)} </span>
                <strong>${esc(isOut ? other?.name || e.target : node.name)}</strong>
                ${e.weight > 1 ? `<span class="tag-pill" style="margin-left:4px;">×${e.weight}</span>` : ''}
              </div>
              ${e.evidence_sentence ? `<div style="font-size:12px;color:var(--ink-secondary);margin-top:4px;">“${esc(e.evidence_sentence)}”</div>` : ''}
            </div>
          `;
        })
        .join('')
    : `<div style="font-size:13px;color:var(--ink-muted);">Chưa có quan hệ rõ ràng trực tiếp. Bạn có thể bật “Hiện liên kết cùng ngữ cảnh” ở phía trên.</div>`;

  box.innerHTML = `
    <div>
      <span class="type-badge" style="background:${meta.bg};color:${meta.color};">${esc(meta.label)}</span>
      <h3 style="margin:6px 0 2px;font-size:17px;">${esc(node.name)}</h3>
      <div style="font-size:12.5px;color:var(--ink-muted);">${node.mentions} lần nhắc · ${data.stats.node_count - 1} thực thể liên kết</div>
    </div>
    ${node.evidence_sentence ? `<div class="topic-chunk-card"><div class="topic-chunk-src">Trích dẫn tiêu biểu</div><div class="topic-chunk-text">“${esc(node.evidence_sentence)}”</div></div>` : ''}
    <div style="display:flex;flex-direction:column;gap:8px;">
      <div class="aside-title">Quan hệ (${rels.length})</div>
      ${relsHtml}
    </div>
  `;
}

// 4c. Entity Table
async function loadEntityTable() {
  const q = $input('ent-table-q').value.trim();
  const type = $select('ent-table-type').value;
  const clean = $input('ent-table-clean').checked;

  const params = new URLSearchParams({
    view: 'entities',
    limit: '150',
    min_mentions: clean ? '2' : '1',
    hide_single_syllable: String(clean),
  });
  if (q) params.set('q', q);
  if (type) params.set('entity_type', type);

  const tbody = $('ent-table-body');
  try {
    const data = await apiFetch(`/knowledge/table?${params.toString()}`);
    $('ent-table-count').textContent = `${data.total} thực thể`;

    if (!data.rows.length) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:36px;color:var(--ink-muted);">Không có thực thể nào phù hợp. Thử bỏ chọn bộ lọc ẩn thực thể ít xuất hiện.</td></tr>`;
      return;
    }

    tbody.innerHTML = data.rows
      .map((r: any) => {
        const meta = ENTITY_TYPE_META[r.type] || ENTITY_TYPE_META.concept;
        const quote = r.evidence_sentence
          ? `“${esc(r.evidence_sentence)}”`
          : `<span style="color:var(--ink-muted);">${esc((r.evidence_refs || []).join(', ') || '—')}</span>`;
        const srcHint = (r.evidence_refs || []).length
          ? `<div style="font-size:11.5px;color:var(--ink-muted);margin-top:3px;">${esc(r.evidence_refs.slice(0, 2).join(' · '))}</div>`
          : '';
        return `
          <tr>
            <td>
              <button type="button" class="btn btn-ghost btn-sm" style="padding:2px 0;font-weight:600;color:var(--accent);" data-table-ego="${esc(r.id)}">${esc(r.name)}</button>
            </td>
            <td><span class="type-badge" style="background:${meta.bg};color:${meta.color};">${esc(meta.label)}</span></td>
            <td><strong>${r.mentions}</strong></td>
            <td>${r.explicit_degree ?? r.degree}</td>
            <td class="evidence-quote">${quote}${srcHint}</td>
          </tr>
        `;
      })
      .join('');

    tbody.querySelectorAll<HTMLButtonElement>('[data-table-ego]').forEach((btn) => {
      btn.addEventListener('click', () => jumpToEntityEgoGraph(btn.dataset.tableEgo!));
    });
  } catch (err: any) {
    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:var(--danger);padding:24px;">${esc(err.message)}</td></tr>`;
  }
}

