---
import '../styles/app.css';
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Memory Lab — Nền tảng SaaS trực quan hóa kho tri thức, đồ thị thực thể, bảng dữ liệu, bộ nhớ agent và đánh giá truy xuất."/>
  <title>Memory Lab — Knowledge &amp; Agent Memory Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet"/>
</head>
<body>
<div class="app-shell">
  <!-- LEFT SAAS SIDEBAR -->
  <aside class="sidebar" aria-label="Điều hướng chính">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="5" r="3"/><circle cx="5" cy="19" r="3"/><circle cx="19" cy="19" r="3"/>
          <line x1="10.5" y1="7.6" x2="6.5" y2="16.4"/><line x1="13.5" y1="7.6" x2="17.5" y2="16.4"/><line x1="8" y1="19" x2="16" y2="19"/>
        </svg>
      </div>
      <div>
        <div class="brand-title">Memory Lab</div>
        <div class="brand-sub">Knowledge Workspace · v0.2</div>
      </div>
    </div>

    <div>
      <div class="nav-group-label">Không gian làm việc</div>
      <nav class="sidebar-nav" role="tablist" aria-label="Workspace tabs">
        <button type="button" class="tab active" data-tab="documents" role="tab" aria-selected="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span>Documents &amp; Pipeline</span>
          <span class="nav-count" id="nav-count-docs">0</span>
        </button>

        <button type="button" class="tab" data-tab="knowledge" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          <span>Knowledge Explorer</span>
          <span class="nav-count" id="nav-count-entities">0</span>
        </button>

        <button type="button" class="tab" data-tab="memory" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 0 0-8 8c0 3.3 2 6.2 5 7.4V20a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-2.6c3-1.2 5-4.1 5-7.4a8 8 0 0 0-8-8z"/></svg>
          <span>Memory Playground</span>
          <span class="nav-count" id="nav-count-mem">0</span>
        </button>

        <button type="button" class="tab" data-tab="experiments" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          <span>Experiments &amp; Eval</span>
          <span class="nav-count" id="nav-count-exp">0</span>
        </button>
      </nav>
    </div>

    <div class="sidebar-footer">
      <label class="api-box">
        <span>API Endpoint</span>
        <input id="api" value="/api" />
      </label>
      <p id="status" class="status-bar" role="status" aria-live="polite"></p>
    </div>
  </aside>

  <!-- MAIN WORKSPACE -->
  <div class="workspace">
    <header class="topbar">
      <form id="global-search-form" class="global-search" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="global-search-input" placeholder="Tìm kiếm nhanh toàn bộ kho tri thức (tài liệu, ký ức, thực thể, quan hệ)…" />
        <span class="kbd">⌘K</span>
        <button type="submit" class="sm">Tìm</button>
      </form>
      <div class="topbar-actions">
        <button type="button" class="sm" id="btn-open-atlas">Embedding Atlas</button>
        <button type="button" class="secondary sm" id="btn-open-graph">Đồ thị tri thức</button>
        <button type="button" class="secondary sm" id="btn-open-table">Bảng tri thức</button>
        <button type="button" class="secondary sm" id="btn-refresh-all">Đồng bộ</button>
      </div>
    </header>

    <main class="workspace-content">
      <!-- KPI OVERVIEW STRIP -->
      <div class="page-header">
        <div>
          <h1 id="page-title">Kho tri thức &amp; Pipeline tài liệu</h1>
          <p class="page-subtitle" id="page-subtitle">Nạp tài liệu, xử lý trích xuất phi-LLM, kiểm tra stage cache và trực quan hóa tri thức hợp nhất.</p>
        </div>
      </div>

      <section class="kpi-strip" aria-label="Thống kê kho tri thức">
        <div class="kpi-item"><div class="kpi-label">Tài liệu</div><div class="kpi-value" id="kpi-docs">0</div></div>
        <div class="kpi-item"><div class="kpi-label">Đoạn tri thức (Chunks)</div><div class="kpi-value" id="kpi-chunks">0</div></div>
        <div class="kpi-item"><div class="kpi-label">Ký ức Agent</div><div class="kpi-value" id="kpi-memories">0</div></div>
        <div class="kpi-item"><div class="kpi-label">Thực thể (Nodes)</div><div class="kpi-value" id="kpi-entities">0</div></div>
        <div class="kpi-item"><div class="kpi-label">Quan hệ (Edges)</div><div class="kpi-value" id="kpi-relations">0</div></div>
        <div class="kpi-item"><div class="kpi-label">Mốc thời gian</div><div class="kpi-value" id="kpi-temporal">0</div></div>
      </section>

      <!-- TAB 1: DOCUMENTS & PIPELINE (Active by default — preserves all Phase 1 E2E selectors) -->
      <div id="tab-documents" class="tab-panel active">
        <section class="card">
          <div class="card-head">
            <h2>1. Tài liệu nguồn</h2>
            <span class="pill accent">Filesystem Source of Truth</span>
          </div>
          <form id="upload" class="row-form">
            <input type="file" id="file" accept=".pdf,.docx,.md,.txt,.html" required/>
            <input id="upload-doc-id" placeholder="Optional document_id UUID (nhóm version mới)" />
            <button type="submit">Upload</button>
          </form>
          <div id="documents"></div>
        </section>

        <section class="card">
          <div class="card-head">
            <h2>2. Pipeline inspector &amp; Stage cache</h2>
            <span class="pill">Non-Generative Enrichment</span>
          </div>
          <p class="hint">Chọn Process trên tài liệu. PDF/DOCX dùng Docling; TXT/Markdown dùng text. Có thể xóa cache từng stage bằng Invalidate.</p>
          <div class="controls">
            <label>Parser <select id="parser"><option value="docling">docling</option><option value="text">text</option></select></label>
            <label>Chunker <select id="chunker"><option value="fixed">fixed</option><option value="hybrid">hybrid</option></select></label>
            <label>Chunk size <input id="chunk-size" type="number" value="1200" min="100" max="10000" style="width:92px"/></label>
            <label>Overlap <input id="chunk-overlap" type="number" value="150" min="0" style="width:80px"/></label>
            <label><input id="enrich-toggle" type="checkbox" checked/> Enrichment</label>
          </div>
          <div id="runs"></div>
          <pre id="artifact">Chọn artifact để xem.</pre>
        </section>

        <section class="card">
          <div class="card-head">
            <h2>3. Retrieval playground</h2>
            <span class="pill">Dense · BM25 · Hybrid RRF</span>
          </div>
          <form id="search" class="row-form">
            <input id="query" placeholder="Nội dung cần tìm trong tài liệu…" required/>
            <select id="search-mode" aria-label="Search mode">
              <option value="dense">dense</option>
              <option value="sparse">sparse (BM25)</option>
              <option value="hybrid">hybrid (RRF)</option>
            </select>
            <input id="filter-doc-id" placeholder="Filter document_id" style="width:170px"/>
            <input id="filter-run-id" placeholder="Filter pipeline_run_id" style="width:170px"/>
            <button type="submit">Tìm kiếm</button>
          </form>
          <div id="results"></div>
        </section>
      </div>

      <!-- TAB 2: KNOWLEDGE EXPLORER (Unified Human Search + Interactive Graph + Knowledge Tables) -->
      <div id="tab-knowledge" class="tab-panel">
        <!-- Unified Human Search -->
        <section class="card">
          <div class="card-head">
            <h2>Tìm kiếm tri thức hợp nhất (Human Search)</h2>
            <div class="segmented" id="kb-scope-control">
              <button type="button" class="active" data-scope="all">Tất cả</button>
              <button type="button" data-scope="documents">Tài liệu</button>
              <button type="button" data-scope="memory">Ký ức</button>
            </div>
          </div>
          <form id="kb-search-form" class="row-form">
            <input id="kb-query" placeholder="Nhập từ khóa, thực thể, mã lỗi, hoặc câu hỏi tiếng Việt / tiếng Anh…" required/>
            <select id="kb-doc-mode" aria-label="Document search mode">
              <option value="hybrid">Docs: hybrid (RRF)</option>
              <option value="sparse">Docs: sparse (BM25)</option>
              <option value="dense">Docs: dense</option>
            </select>
            <select id="kb-mem-strategy" aria-label="Memory strategy">
              <option value="hybrid">Memory: hybrid</option>
              <option value="zero_token">Memory: zero_token</option>
              <option value="graph">Memory: graph</option>
              <option value="vector">Memory: vector</option>
            </select>
            <input id="kb-temporal" placeholder="Mốc YYYY-MM" style="width:130px"/>
            <button type="submit">Tìm tri thức</button>
          </form>
          <div id="kb-search-meta" class="meta"></div>
          <div id="kb-search-entities" class="meta"></div>
          <div id="kb-search-results"></div>
        </section>

        <!-- Interactive Visualization Switcher: Embedding Atlas, Graph & Table -->
        <section class="card">
          <div class="card-head">
            <h2>Trực quan hóa Kho tri thức</h2>
            <div class="controls">
              <div class="segmented" id="kb-viz-switch">
                <button type="button" class="active" data-viz="atlas">Embedding Atlas</button>
                <button type="button" data-viz="graph">Đồ thị tri thức</button>
                <button type="button" data-viz="table">Bảng dữ liệu</button>
              </div>
              <select id="kb-source-filter" aria-label="Source filter">
                <option value="all">Nguồn: Tất cả</option>
                <option value="documents">Chỉ Tài liệu</option>
                <option value="memory">Chỉ Ký ức</option>
              </select>
            </div>
          </div>

          <!-- EMBEDDING ATLAS VIEW (Apple Embedding Atlas-inspired) -->
          <div id="kb-viz-atlas">
            <div class="controls" style="justify-content:space-between">
              <div class="controls">
                <input id="atlas-search-input" placeholder="Tìm & highlight trên Embedding Atlas…" style="min-width:230px"/>
                <label>Màu theo
                  <select id="atlas-color-by">
                    <option value="cluster">Cụm tự động (Cluster)</option>
                    <option value="source_type">Nguồn (Document / Memory)</option>
                    <option value="strategy">Chiến lược (Strategy)</option>
                    <option value="session_id">Session / Tài liệu</option>
                  </select>
                </label>
                <div class="segmented" id="atlas-mode-switch">
                  <button type="button" class="active" data-mode="pan">Pan / Chọn điểm</button>
                  <button type="button" data-mode="brush">Quét vùng (Brush)</button>
                </div>
                <label><input id="atlas-contours" type="checkbox" checked/> Density Contours</label>
                <label><input id="atlas-labels" type="checkbox" checked/> Cluster Labels</label>
              </div>
              <div class="controls">
                <span class="pill accent" id="atlas-filter-status">0 / 0 điểm</span>
                <button type="button" class="secondary sm" id="btn-atlas-clear-filters">Xóa bộ lọc</button>
              </div>
            </div>

            <div class="atlas-layout">
              <div class="atlas-stage-wrap">
                <div class="graph-toolbar">
                  <button type="button" class="secondary sm" id="btn-atlas-zoom-in" title="Phóng to">+</button>
                  <button type="button" class="secondary sm" id="btn-atlas-zoom-out" title="Thu nhỏ">−</button>
                  <button type="button" class="secondary sm" id="btn-atlas-zoom-reset" title="Đặt lại">Reset</button>
                </div>
                <canvas id="embedding-atlas-canvas" aria-label="Bản đồ Embedding Atlas 2D tương tác"></canvas>
                <div id="atlas-tooltip" class="atlas-tooltip"></div>
                <div class="atlas-meta-strip" id="atlas-meta-strip">SVD + kNN · KDE Contours</div>
              </div>

              <aside class="atlas-sidebar" aria-label="Bộ lọc chéo và chi tiết điểm">
                <div class="facet-card" id="atlas-inspector">
                  <h3>Điểm đang chọn &amp; Nearest Neighbors</h3>
                  <p class="hint" style="margin:0">Nhấp vào một điểm trên bản đồ để xem nội dung, chứng cứ và top láng giềng gần nhất.</p>
                </div>
                <div class="facet-card">
                  <h3>Cụm tri thức (Auto Clusters)</h3>
                  <div id="atlas-facet-clusters"></div>
                </div>
                <div class="facet-card">
                  <h3>Nguồn &amp; Chiến lược</h3>
                  <div id="atlas-facet-strategies"></div>
                </div>
                <div class="facet-card">
                  <h3>Phân bố thời gian</h3>
                  <div id="atlas-facet-dates"></div>
                </div>
                <div class="facet-card">
                  <h3>Thực thể nổi bật</h3>
                  <div id="atlas-facet-entities" class="meta" style="margin:0"></div>
                </div>
              </aside>
            </div>

            <div style="margin-top:16px">
              <div class="card-head" style="margin-bottom:6px">
                <h3>Bảng dữ liệu liên kết theo vùng chọn (Cross-Filtered Table)</h3>
                <span class="hint" style="margin:0">Nhấp vào một dòng để phóng tới điểm tương ứng trên Embedding Atlas.</span>
              </div>
              <div id="atlas-linked-table" class="table-wrap"></div>
            </div>
          </div>

          <!-- GRAPH VIEW -->
          <div id="kb-viz-graph" style="display:none">
            <div class="controls">
              <input id="kb-graph-entity" placeholder="Tập trung theo thực thể (vd: Qdrant, Neo4j)…" style="min-width:260px"/>
              <label><input id="kb-graph-cooccur" type="checkbox" checked/> Hiện quan hệ đồng xuất hiện</label>
              <button type="button" id="btn-kb-graph-apply">Cập nhật đồ thị</button>
              <button type="button" class="secondary" id="btn-kb-graph-clear">Xem toàn bộ</button>
            </div>

            <div class="graph-layout">
              <div class="graph-stage-wrap">
                <div class="graph-toolbar">
                  <button type="button" class="secondary sm" id="btn-zoom-in" title="Phóng to">+</button>
                  <button type="button" class="secondary sm" id="btn-zoom-out" title="Thu nhỏ">−</button>
                  <button type="button" class="secondary sm" id="btn-zoom-reset" title="Đặt lại">Reset</button>
                </div>
                <svg id="knowledge-graph-svg" role="img" aria-label="Đồ thị tri thức tương tác"></svg>
                <div class="graph-legend">
                  <span class="legend-dot"><i style="background:#0e7490"></i>Technology</span>
                  <span class="legend-dot"><i style="background:#3b5998"></i>Organization</span>
                  <span class="legend-dot"><i style="background:#146c43"></i>Concept</span>
                  <span class="legend-dot"><i style="background:#b45309"></i>Person / Date</span>
                </div>
              </div>

              <aside class="graph-inspector" id="kb-graph-inspector" aria-label="Chi tiết thực thể">
                <div class="inspector-empty">Nhấp vào một nút trên đồ thị để xem thông tin chi tiết, quan hệ liên kết và nguồn chứng cứ.</div>
              </aside>
            </div>
          </div>

          <!-- TABLE VIEW -->
          <div id="kb-viz-table" style="display:none">
            <div class="controls" style="justify-content:space-between; margin-bottom:10px">
              <div class="segmented" id="kb-table-views">
                <button type="button" class="active" data-view="entities">Thực thể</button>
                <button type="button" data-view="relations">Quan hệ</button>
                <button type="button" data-view="chunks">Đoạn tài liệu</button>
                <button type="button" data-view="memories">Ký ức</button>
                <button type="button" data-view="timeline">Dòng thời gian</button>
              </div>
              <form id="kb-table-filter-form" class="controls" style="flex:1; justify-content:flex-end">
                <input id="kb-table-filter" placeholder="Lọc nhanh trong bảng…"/>
                <button type="submit" class="secondary">Lọc</button>
              </form>
            </div>
            <div id="kb-table-summary" class="hint"></div>
            <div id="kb-table-container" class="table-wrap"></div>
          </div>
        </section>
      </div>

      <!-- TAB 3: MEMORY PLAYGROUND (Preserves all Phase 2 & 3 E2E selectors) -->
      <div id="tab-memory" class="tab-panel">
        <div class="grid-2">
          <section class="card">
            <div class="card-head">
              <h2>Lưu ký ức / Interaction trace</h2>
              <span class="pill accent">MCP Ready</span>
            </div>
            <form id="mem-store-form" class="stack-form">
              <textarea id="mem-content" rows="4" placeholder="Ví dụ: Memory Lab uses Qdrant and Neo4j for hybrid retrieval since 2026-11-25." required></textarea>
              <div class="controls">
                <label>Strategy
                  <select id="mem-store-strategy">
                    <option value="hybrid">hybrid</option>
                    <option value="zero_token">zero_token</option>
                    <option value="graph">graph</option>
                    <option value="vector">vector</option>
                  </select>
                </label>
                <label>Session <input id="mem-session" value="default" style="width:120px"/></label>
                <label>Role
                  <select id="mem-role">
                    <option value="user">user</option>
                    <option value="assistant">assistant</option>
                    <option value="system">system</option>
                    <option value="tool">tool</option>
                  </select>
                </label>
                <label>Tags <input id="mem-tags" placeholder="rag, architecture"/></label>
              </div>
              <button type="submit">Store memory</button>
            </form>
          </section>

          <section class="card">
            <div class="card-head">
              <h2>Tìm kiếm Memory</h2>
              <span class="pill">RRF Score Breakdown</span>
            </div>
            <form id="mem-search-form" class="stack-form">
              <input id="mem-query" placeholder="Truy vấn ký ức…" required/>
              <div class="controls">
                <label>Strategy
                  <select id="mem-search-strategy">
                    <option value="hybrid">hybrid</option>
                    <option value="zero_token">zero_token</option>
                    <option value="graph">graph</option>
                    <option value="vector">vector</option>
                  </select>
                </label>
                <label>Session <input id="mem-search-session" placeholder="all" style="width:104px"/></label>
                <label>Temporal <input id="mem-search-temporal" placeholder="YYYY-MM-DD" style="width:120px"/></label>
                <label>Limit <input id="mem-search-limit" type="number" value="5" min="1" max="50" style="width:68px"/></label>
              </div>
              <button type="submit">Search memory</button>
            </form>
            <div id="mem-results"></div>
          </section>
        </div>

        <section class="card">
          <div class="card-head">
            <h2>Memory Records, Temporal Hierarchy &amp; Knowledge Graph</h2>
            <div class="controls">
              <button type="button" class="secondary" id="btn-refresh-mem">Làm mới</button>
              <input id="graph-entity-filter" placeholder="Lọc entity trong Graph…" />
              <button type="button" class="secondary" id="btn-filter-graph">Xem Graph</button>
            </div>
          </div>
          <div class="grid-3">
            <div>
              <h3>Records (<span id="mem-record-count">0</span>)</h3>
              <div id="mem-records"></div>
            </div>
            <div>
              <h3>Temporal Hierarchy</h3>
              <pre id="mem-temporal" class="compact-pre">Chưa có dữ liệu.</pre>
            </div>
            <div>
              <h3>Knowledge Graph (JSON)</h3>
              <pre id="mem-graph" class="compact-pre">Chưa có dữ liệu.</pre>
            </div>
          </div>
        </section>
      </div>

      <!-- TAB 4: EXPERIMENTATION & COMPARISON (Preserves all Phase 4 E2E selectors) -->
      <div id="tab-experiments" class="tab-panel">
        <div class="grid-2">
          <section class="card">
            <div class="card-head">
              <h2>1. Benchmark Datasets</h2>
              <span class="pill">Content-Addressed Hash</span>
            </div>
            <form id="exp-dataset-form" class="stack-form">
              <input id="exp-ds-name" placeholder="Tên dataset (vd: core-retrieval-v1)" required/>
              <input id="exp-ds-desc" placeholder="Mô tả ngắn"/>
              <textarea id="exp-ds-cases" rows="5" placeholder='[{"query": "evidence", "relevant_substrings": ["Memory Lab"]}]' required></textarea>
              <div class="controls">
                <button type="submit">Tạo dataset</button>
                <button type="button" class="secondary" id="btn-ds-sample">Chèn mẫu JSON</button>
              </div>
            </form>
            <div id="exp-datasets"></div>
          </section>

          <section class="card">
            <div class="card-head">
              <h2>2. Chạy Benchmark Experiment</h2>
              <span class="pill">Recall@K · MRR · nDCG@K</span>
            </div>
            <form id="exp-run-form" class="stack-form">
              <input id="exp-run-name" placeholder="Tên cấu hình (vd: hybrid-rrf-k5)" required/>
              <div class="controls">
                <label>Dataset <select id="exp-run-dataset"></select></label>
                <label>Target
                  <select id="exp-run-target">
                    <option value="documents">documents</option>
                    <option value="memory">memory</option>
                  </select>
                </label>
                <label>K <input id="exp-run-k" type="number" value="5" min="1" max="50" style="width:68px"/></label>
              </div>
              <div class="controls">
                <label>Doc mode
                  <select id="exp-run-mode">
                    <option value="dense">dense</option>
                    <option value="sparse">sparse</option>
                    <option value="hybrid">hybrid</option>
                  </select>
                </label>
                <label>Memory strategy
                  <select id="exp-run-strategy">
                    <option value="hybrid">hybrid</option>
                    <option value="zero_token">zero_token</option>
                    <option value="graph">graph</option>
                    <option value="vector">vector</option>
                  </select>
                </label>
              </div>
              <div class="controls">
                <input id="exp-run-doc-filter" placeholder="Filter document_id (tùy chọn)"/>
                <input id="exp-run-run-filter" placeholder="Filter pipeline_run_id (tùy chọn)"/>
              </div>
              <button type="submit">Chạy đánh giá (Recall@K / MRR / nDCG)</button>
            </form>
          </section>
        </div>

        <section class="card">
          <div class="card-head">
            <h2>3. Comparison UI (Recall@K · MRR · nDCG@K · Latency)</h2>
            <button type="button" id="btn-compare">So sánh các báo cáo đã chọn</button>
          </div>
          <div id="exp-reports"></div>
          <div id="exp-comparison"></div>
        </section>
      </div>
    </main>
  </div>
</div>

<script>
import {
  EmbeddingAtlasCanvas,
  atlasColorForPoint,
  clusterColor,
  type AtlasColorBy,
  type AtlasFilterState,
  type AtlasInteractionMode,
  type AtlasPayload,
  type AtlasPoint,
} from '../lib/atlas';
import { InteractiveKnowledgeGraph, type GraphEdgeData, type GraphNodeData } from '../lib/graph';

const el = (id: string) => document.getElementById(id)!;
const input = (id: string) => el(id) as HTMLInputElement;
const select = (id: string) => el(id) as HTMLSelectElement;
const base = () => input('api').value.replace(/\/$/, '');

const TAB_META: Record<string, { title: string; subtitle: string }> = {
  documents: {
    title: 'Kho tri thức & Pipeline tài liệu',
    subtitle: 'Nạp tài liệu, xử lý trích xuất phi-LLM, kiểm tra stage cache và truy xuất nguồn chứng cứ.',
  },
  knowledge: {
    title: 'Knowledge Explorer — Embedding Atlas, Đồ thị & Bảng',
    subtitle: 'Khám phá không gian embedding 2D kèm KDE contours, lọc chéo đa chiều, đồ thị thực thể và bảng dữ liệu.',
  },
  memory: {
    title: 'Agent Memory Playground',
    subtitle: 'Lưu trữ interaction traces, kiểm thử Vector / Graph / ZeroToken / Hybrid và phân cấp thời gian.',
  },
  experiments: {
    title: 'Experimentation & Benchmark Evaluation',
    subtitle: 'Tạo bộ đề đánh giá có dataset_hash, đo Recall@K, MRR, nDCG@K và so sánh cấu hình song song.',
  },
};

let activeKbScope = 'all';
let activeKbTableView = 'entities';
let activeKbViz: 'atlas' | 'graph' | 'table' = 'atlas';
let graphEngine: InteractiveKnowledgeGraph | null = null;
let atlasEngine: EmbeddingAtlasCanvas | null = null;
let atlasData: AtlasPayload | null = null;
let atlasFilters: AtlasFilterState = {
  clusterId: null,
  sourceType: null,
  strategy: null,
  date: null,
  entity: null,
  query: '',
  brushIds: null,
};

async function request(path: string, init?: RequestInit) {
  const response = await fetch(base() + path, init);
  if (!response.ok) throw new Error(await response.text());
  if (response.status === 204) return null;
  return response.json();
}

async function action(work: () => Promise<void>) {
  const statusEl = el('status');
  statusEl.className = 'status-bar';
  statusEl.textContent = 'Đang xử lý…';
  try {
    await work();
    statusEl.className = 'status-bar ok';
    statusEl.textContent = 'Hoàn tất.';
  } catch (error) {
    statusEl.className = 'status-bar err';
    statusEl.textContent = String(error);
  }
}

function button(label: string, work: () => Promise<void>, className = '') {
  const node = document.createElement('button');
  node.type = 'button';
  node.textContent = label;
  if (className) node.className = className;
  node.onclick = () => action(work);
  return node;
}

function pill(text: string, extraClass = '') {
  const span = document.createElement('span');
  span.className = extraClass ? `pill ${extraClass}` : 'pill';
  span.textContent = text;
  return span;
}

function switchTab(target: string) {
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => {
    const active = b.dataset.tab === target;
    b.classList.toggle('active', active);
    b.setAttribute('aria-selected', String(active));
  });
  document.querySelectorAll('.tab-panel').forEach((p) => {
    p.classList.toggle('active', p.id === `tab-${target}`);
  });
  const meta = TAB_META[target];
  if (meta) {
    el('page-title').textContent = meta.title;
    el('page-subtitle').textContent = meta.subtitle;
  }
  if (target === 'knowledge') {
    action(refreshKnowledge);
  }
}

function switchKbViz(viz: 'atlas' | 'graph' | 'table') {
  activeKbViz = viz;
  document.querySelectorAll<HTMLButtonElement>('#kb-viz-switch button').forEach((b) => {
    b.classList.toggle('active', b.dataset.viz === viz);
  });
  el('kb-viz-atlas').style.display = viz === 'atlas' ? 'block' : 'none';
  el('kb-viz-graph').style.display = viz === 'graph' ? 'block' : 'none';
  el('kb-viz-table').style.display = viz === 'table' ? 'block' : 'none';
  if (viz === 'atlas') action(refreshEmbeddingAtlas);
  else if (viz === 'graph') action(refreshKnowledgeGraph);
  else action(refreshKnowledgeTable);
}

// --- Tab navigation & Shortcuts ---
for (const tabBtn of document.querySelectorAll<HTMLButtonElement>('.tab')) {
  tabBtn.onclick = () => switchTab(tabBtn.dataset.tab!);
}

window.addEventListener('keydown', (ev) => {
  if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === 'k') {
    ev.preventDefault();
    input('global-search-input').focus();
  }
});

// --- Workspace Overview KPIs ---
async function refreshOverview() {
  const ov = await request('/knowledge/overview');
  el('kpi-docs').textContent = String(ov.documents_count);
  el('kpi-chunks').textContent = String(ov.chunks_count);
  el('kpi-memories').textContent = String(ov.memory_records_count);
  el('kpi-entities').textContent = String(ov.entities_count);
  el('kpi-relations').textContent = String(ov.relations_count);
  el('kpi-temporal').textContent = String(ov.temporal_anchors_count);
  el('nav-count-docs').textContent = String(ov.documents_count);
  el('nav-count-entities').textContent = String(ov.entities_count);
  el('nav-count-mem').textContent = String(ov.memory_records_count);
  el('nav-count-exp').textContent = String(ov.reports_count);
}

// --- TAB 1: Documents & Pipeline ---
async function refreshDocuments() {
  const docs = await request('/documents');
  el('documents').replaceChildren();
  if (!docs.length) {
    const empty = document.createElement('div');
    empty.className = 'empty-state';
    empty.textContent = 'Chưa có tài liệu nào. Upload PDF, DOCX, Markdown, TXT hoặc HTML để bắt đầu xây dựng kho tri thức.';
    el('documents').append(empty);
  }
  for (const doc of docs) {
    const row = document.createElement('article');
    const title = document.createElement('p');
    const strong = document.createElement('strong');
    strong.textContent = `${doc.filename} · ${doc.version.slice(0, 10)}`;
    title.append(strong);
    const meta = document.createElement('div');
    meta.className = 'meta';
    meta.append(pill(`doc:${doc.id.slice(0, 10)}`), pill(`sha:${doc.content_hash.slice(0, 10)}`));
    const controls = document.createElement('div');
    controls.className = 'controls';
    controls.append(
      button('Process', async () => {
        const payload = {
          parser: select('parser').value,
          chunker: select('chunker').value,
          chunk_size: Number(input('chunk-size').value || 1200),
          overlap: Number(input('chunk-overlap').value || 150),
          enrich: input('enrich-toggle').checked,
        };
        await request(`/documents/${doc.id}/versions/${doc.version}/process`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        await Promise.all([refreshDocuments(), refreshOverview()]);
      }, 'sm')
    );
    row.append(title, meta, controls);
    el('documents').append(row);
  }

  const runs = await request('/runs');
  el('runs').replaceChildren();
  for (const run of runs) {
    const row = document.createElement('article');
    const title = document.createElement('p');
    const enrichSummary = run.enrichment_summary
      ? ` · entities:${run.enrichment_summary.entity_count} rels:${run.enrichment_summary.relation_count}`
      : '';
    title.textContent = `${run.pipeline_run_id.slice(0, 12)} · ${run.status}${enrichSummary}`;
    row.append(title);

    const actions = document.createElement('div');
    actions.className = 'controls';
    for (const artifact of ['manifest', 'normalized', 'chunks', 'enriched']) {
      actions.append(
        button(artifact, async () => {
          el('artifact').textContent = JSON.stringify(
            await request(`/runs/${run.pipeline_run_id}/${artifact}`),
            null,
            2
          );
        }, 'secondary sm')
      );
    }

    const stageSelect = document.createElement('select');
    for (const stage of ['parse', 'normalize', 'chunk', 'enrich', 'index']) {
      const opt = document.createElement('option');
      opt.value = stage;
      opt.textContent = `invalidate:${stage}`;
      stageSelect.append(opt);
    }
    actions.append(
      stageSelect,
      button(
        'Invalidate',
        async () => {
          const updated = await request(`/runs/${run.pipeline_run_id}/invalidate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ stages: [stageSelect.value] }),
          });
          el('artifact').textContent = JSON.stringify(updated, null, 2);
          await Promise.all([refreshDocuments(), refreshOverview()]);
        },
        'danger sm'
      )
    );
    row.append(actions);
    el('runs').append(row);
  }
}

// --- TAB 2: Knowledge Explorer (Graph + Table + Unified Human Search) ---
function renderGraphInspector(node: GraphNodeData, edges: GraphEdgeData[]) {
  const panel = el('kb-graph-inspector');
  panel.replaceChildren();

  const head = document.createElement('div');
  const h = document.createElement('h3');
  h.style.margin = '0 0 6px';
  h.style.color = 'var(--ink-primary)';
  h.style.fontSize = '17px';
  h.textContent = node.name;
  const meta = document.createElement('div');
  meta.className = 'meta';
  meta.append(
    pill(node.type, `type-${node.type}`),
    pill(`${node.mentions} mentions`),
    pill(`${node.degree} links`),
    ...node.sources.map((s) => pill(s, 'accent'))
  );
  head.append(h, meta);

  const searchBtn = button(
    `Tìm kiếm "${node.name}"`,
    async () => {
      input('kb-query').value = node.name;
      await runUnifiedKnowledgeSearch(node.name);
    },
    'sm'
  );

  const relHeader = document.createElement('h3');
  relHeader.style.margin = '6px 0 0';
  relHeader.textContent = `Quan hệ liên kết (${edges.length})`;

  const relList = document.createElement('div');
  relList.style.display = 'flex';
  relList.style.flexDirection = 'column';
  relList.style.gap = '6px';
  relList.style.overflowY = 'auto';
  relList.style.maxHeight = '220px';

  for (const edge of edges.slice(0, 15)) {
    const item = document.createElement('div');
    item.className = 'rel-item';
    const other = edge.source === node.id ? edge.target : edge.source;
    const arrow = edge.source === node.id ? `→ ${other}` : `← ${other}`;
    const line1 = document.createElement('div');
    const code = document.createElement('code');
    code.textContent = edge.predicate;
    line1.append(code, ` ${arrow}`);
    const line2 = document.createElement('div');
    line2.style.fontSize = '11.5px';
    line2.style.color = 'var(--ink-muted)';
    line2.style.marginTop = '3px';
    line2.textContent = `${edge.source_label} · conf ${edge.confidence}`;
    item.append(line1, line2);
    relList.append(item);
  }
  if (!edges.length) {
    const p = document.createElement('p');
    p.className = 'hint';
    p.textContent = 'Chưa có quan hệ trực tiếp.';
    relList.append(p);
  }

  const srcHeader = document.createElement('h3');
  srcHeader.style.margin = '4px 0 0';
  srcHeader.textContent = 'Nguồn chứng cứ';
  const srcList = document.createElement('div');
  srcList.className = 'meta';
  for (const ref of node.evidence_refs) {
    srcList.append(pill(ref));
  }

  panel.append(head, searchBtn, relHeader, relList, srcHeader, srcList);
}

async function refreshKnowledgeGraph() {
  const svg = document.getElementById('knowledge-graph-svg') as unknown as SVGSVGElement;
  if (!graphEngine) {
    graphEngine = new InteractiveKnowledgeGraph(svg, renderGraphInspector);
  }
  const params = new URLSearchParams({
    source: select('kb-source-filter').value,
    include_cooccurrence: String(input('kb-graph-cooccur').checked),
    max_nodes: '80',
  });
  const focus = input('kb-graph-entity').value.trim();
  if (focus) params.set('entity', focus);

  const payload = await request(`/knowledge/graph?${params.toString()}`);
  graphEngine.render(payload);
}

async function refreshKnowledgeTable() {
  const params = new URLSearchParams({
    view: activeKbTableView,
    source: select('kb-source-filter').value,
    limit: '100',
  });
  const q = input('kb-table-filter').value.trim();
  if (q) params.set('q', q);

  const data = await request(`/knowledge/table?${params.toString()}`);
  el('kb-table-summary').textContent = `Hiển thị ${data.rows.length} / ${data.total} bản ghi (${data.view}). Nhấp vào thực thể để xem trên đồ thị.`;

  const wrap = el('kb-table-container');
  wrap.replaceChildren();
  if (!data.rows.length) {
    const empty = document.createElement('div');
    empty.className = 'empty-state';
    empty.textContent = 'Không có dữ liệu phù hợp với bộ lọc hiện tại.';
    wrap.append(empty);
    return;
  }

  const table = document.createElement('table');
  const thead = document.createElement('thead');
  const headTr = document.createElement('tr');
  const LABELS: Record<string, string> = {
    name: 'Thực thể',
    type: 'Loại',
    mentions: 'Lượt nhắc',
    degree: 'Liên kết',
    sources: 'Nguồn',
    evidence_refs: 'Chứng cứ',
    subject: 'Chủ thể',
    predicate: 'Quan hệ',
    object: 'Đối tượng',
    confidence: 'Độ tin cậy',
    source_type: 'Loại nguồn',
    source_label: 'Nguồn gốc',
    filename: 'Tài liệu',
    block_ids: 'Blocks',
    entities: 'Thực thể',
    temporal: 'Thời gian',
    preview: 'Trích đoạn',
    source_url: 'Tải gốc',
    timestamp: 'Thời gian',
    strategy: 'Chiến lược',
    session_id: 'Session',
    tags: 'Tags',
    summary: 'Tóm tắt',
    date: 'Ngày / Mốc',
    granularity: 'Cấp độ',
    label: 'Nhãn nguồn',
  };

  for (const col of data.columns) {
    const th = document.createElement('th');
    th.textContent = LABELS[col] || col;
    headTr.append(th);
  }
  thead.append(headTr);

  const tbody = document.createElement('tbody');
  for (const row of data.rows) {
    const tr = document.createElement('tr');
    for (const col of data.columns) {
      const td = document.createElement('td');
      const val = row[col];
      if (col === 'name' && activeKbTableView === 'entities') {
        const link = document.createElement('a');
        link.href = '#';
        link.textContent = String(val);
        link.onclick = (ev) => {
          ev.preventDefault();
          input('kb-graph-entity').value = String(val);
          switchKbViz('graph');
        };
        td.append(link);
      } else if (col === 'type') {
        td.append(pill(String(val), `type-${val}`));
      } else if (col === 'predicate') {
        const code = document.createElement('code');
        code.textContent = String(val);
        td.append(code);
      } else if (col === 'source_url' && val) {
        const a = document.createElement('a');
        a.href = base() + String(val);
        a.textContent = 'Tải file';
        td.append(a);
      } else if (Array.isArray(val)) {
        const wrapPills = document.createElement('div');
        wrapPills.className = 'meta';
        wrapPills.style.margin = '0';
        for (const item of val.slice(0, 5)) {
          wrapPills.append(pill(String(item)));
        }
        td.append(wrapPills);
      } else {
        td.textContent = val == null ? '' : String(val);
      }
      tr.append(td);
    }
    tbody.append(tr);
  }
  table.append(thead, tbody);
  wrap.append(table);
}

async function runUnifiedKnowledgeSearch(queryText: string) {
  const params = new URLSearchParams({
    q: queryText,
    scope: activeKbScope,
    doc_mode: select('kb-doc-mode').value,
    memory_strategy: select('kb-mem-strategy').value,
    limit: '8',
  });
  const temp = input('kb-temporal').value.trim();
  if (temp) params.set('temporal_bucket', temp);

  const res = await request(`/knowledge/search?${params.toString()}`);

  const metaEl = el('kb-search-meta');
  metaEl.replaceChildren(
    pill(`${res.total_hits} kết quả`, 'accent'),
    pill(`${res.documents.length} tài liệu`),
    pill(`${res.memories.length} ký ức`),
    pill(`${res.matched_entities.length} thực thể`),
    pill(`${res.latency_ms} ms`)
  );

  const entEl = el('kb-search-entities');
  entEl.replaceChildren();
  for (const ent of res.matched_entities) {
    const p = pill(`${ent.name} (${ent.mentions})`, `type-${ent.type} clickable`);
    p.onclick = () => {
      input('kb-graph-entity').value = ent.name;
      switchKbViz('graph');
    };
    entEl.append(p);
  }

  const out = el('kb-search-results');
  out.replaceChildren();
  const cols = document.createElement('div');
  cols.className = 'search-columns';

  // Documents bucket
  const docBucket = document.createElement('div');
  docBucket.className = 'search-bucket';
  const docH = document.createElement('h3');
  docH.textContent = `Tài liệu phù hợp (${res.documents.length})`;
  docBucket.append(docH);
  if (!res.documents.length) {
    const p = document.createElement('p');
    p.className = 'hint';
    p.textContent = 'Không tìm thấy đoạn tài liệu khớp.';
    docBucket.append(p);
  }
  for (const hit of res.documents) {
    const card = document.createElement('div');
    card.className = 'search-hit-card';
    const text = document.createElement('p');
    text.textContent = hit.chunk.text;
    const m = document.createElement('div');
    m.className = 'meta';
    m.append(pill(hit.filename || hit.chunk.document_id.slice(0, 8), 'accent'));
    for (const [k, v] of Object.entries(hit.score_breakdown || {})) {
      m.append(pill(`${k}:${Number(v).toFixed(3)}`));
    }
    const a = document.createElement('a');
    a.href = base() + hit.source_url;
    a.textContent = `Tải nguồn gốc · blocks ${hit.chunk.block_ids.join(', ')}`;
    card.append(text, m, a);
    docBucket.append(card);
  }

  // Memories bucket
  const memBucket = document.createElement('div');
  memBucket.className = 'search-bucket';
  const memH = document.createElement('h3');
  memH.textContent = `Ký ức Agent phù hợp (${res.memories.length})`;
  memBucket.append(memH);
  if (!res.memories.length) {
    const p = document.createElement('p');
    p.className = 'hint';
    p.textContent = 'Không tìm thấy ký ức khớp.';
    memBucket.append(p);
  }
  for (const hit of res.memories) {
    const card = document.createElement('div');
    card.className = 'search-hit-card';
    const text = document.createElement('p');
    text.textContent = hit.record.content;
    const m = document.createElement('div');
    m.className = 'meta';
    m.append(
      pill(`${hit.strategy} · ${hit.score.toFixed(4)}`, 'accent'),
      pill(`session:${hit.record.session_id}`),
      pill(hit.record.timestamp.slice(0, 10))
    );
    for (const [k, v] of Object.entries(hit.score_breakdown || {})) {
      m.append(pill(`${k}:${Number(v).toFixed(3)}`));
    }
    card.append(text, m);
    memBucket.append(card);
  }

  cols.append(docBucket, memBucket);
  out.append(cols);
}

// --- EMBEDDING ATLAS LOGIC (Apple Embedding Atlas-inspired Cross-Filtering) ---
function pointMatchesAtlasFilters(pt: AtlasPoint, ignore?: keyof AtlasFilterState): boolean {
  if (ignore !== 'clusterId' && atlasFilters.clusterId !== null && pt.cluster_id !== atlasFilters.clusterId) return false;
  if (ignore !== 'sourceType' && atlasFilters.sourceType && pt.source_type !== atlasFilters.sourceType) return false;
  if (ignore !== 'strategy' && atlasFilters.strategy && pt.strategy !== atlasFilters.strategy) return false;
  if (ignore !== 'date' && atlasFilters.date && pt.date !== atlasFilters.date) return false;
  if (ignore !== 'entity' && atlasFilters.entity && !pt.entities.includes(atlasFilters.entity)) return false;
  if (ignore !== 'brushIds' && atlasFilters.brushIds && !atlasFilters.brushIds.has(pt.id)) return false;
  if (ignore !== 'query' && atlasFilters.query.trim()) {
    const terms = atlasFilters.query.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const hay = `${pt.title} ${pt.text} ${pt.cluster_label} ${pt.entities.join(' ')} ${pt.tags.join(' ')}`.toLowerCase();
    if (!terms.some((t) => hay.includes(t))) return false;
  }
  return true;
}

function renderAtlasInspector(point: AtlasPoint | null) {
  const panel = el('atlas-inspector');
  panel.replaceChildren();
  const heading = document.createElement('h3');
  heading.textContent = 'Điểm đang chọn & Nearest Neighbors';
  panel.append(heading);

  if (!point) {
    const empty = document.createElement('p');
    empty.className = 'hint';
    empty.style.margin = '0';
    empty.textContent = 'Nhấp vào một điểm trên bản đồ để xem nội dung, chứng cứ và top láng giềng gần nhất.';
    panel.append(empty);
    return;
  }

  const title = document.createElement('strong');
  title.style.display = 'block';
  title.style.fontSize = '13.5px';
  title.style.marginBottom = '4px';
  title.textContent = point.title;

  const meta = document.createElement('div');
  meta.className = 'meta';
  meta.append(
    pill(point.cluster_label, 'accent'),
    pill(point.source_type),
    pill(point.strategy),
    pill(point.date)
  );

  const body = document.createElement('p');
  body.style.fontSize = '12.5px';
  body.style.margin = '6px 0 8px';
  body.style.color = 'var(--ink-secondary)';
  body.textContent = point.text;

  panel.append(title, meta, body);

  if (point.source_url) {
    const dl = document.createElement('a');
    dl.href = base() + point.source_url;
    dl.style.fontSize = '12px';
    dl.style.display = 'inline-block';
    dl.style.marginBottom = '8px';
    dl.textContent = `Tải nguồn gốc · blocks ${point.block_ids.join(', ')}`;
    panel.append(dl);
  }

  if (point.neighbors?.length) {
    const nh = document.createElement('div');
    nh.style.fontSize = '11px';
    nh.style.fontWeight = '600';
    nh.style.color = 'var(--ink-muted)';
    nh.style.textTransform = 'uppercase';
    nh.style.margin = '6px 0';
    nh.textContent = `Nearest Neighbors (${point.neighbors.length})`;
    panel.append(nh);

    const list = document.createElement('div');
    list.style.display = 'flex';
    list.style.flexDirection = 'column';
    list.style.gap = '5px';
    for (const nbr of point.neighbors) {
      const row = document.createElement('div');
      row.className = 'knn-row';
      const lbl = document.createElement('span');
      lbl.className = 'facet-row-label';
      lbl.textContent = nbr.title;
      const sc = document.createElement('span');
      sc.className = 'knn-score';
      sc.textContent = nbr.score.toFixed(3);
      row.append(lbl, sc);
      row.onclick = () => atlasEngine?.selectPointById(nbr.id);
      list.append(row);
    }
    panel.append(list);
  }
}

function renderFacetBars(
  containerId: string,
  items: { key: string | number; label: string; total: number; filtered: number; color: string; active: boolean }[],
  onClick: (key: string | number) => void
) {
  const wrap = el(containerId);
  wrap.replaceChildren();
  const maxTotal = Math.max(1, ...items.map((i) => i.total));
  if (!items.length) {
    const p = document.createElement('p');
    p.className = 'hint';
    p.style.margin = '0';
    p.textContent = 'Chưa có dữ liệu.';
    wrap.append(p);
    return;
  }
  for (const item of items) {
    const row = document.createElement('div');
    row.className = item.active ? 'facet-row active' : 'facet-row';
    row.onclick = () => onClick(item.key);

    const head = document.createElement('div');
    head.className = 'facet-row-head';
    const lbl = document.createElement('span');
    lbl.className = 'facet-row-label';
    lbl.textContent = item.label;
    const cnt = document.createElement('span');
    cnt.className = 'facet-row-count';
    cnt.textContent = item.filtered === item.total ? `${item.total}` : `${item.filtered}/${item.total}`;
    head.append(lbl, cnt);

    const track = document.createElement('div');
    track.className = 'facet-bar-track';
    const ghost = document.createElement('div');
    ghost.className = 'facet-bar-ghost';
    ghost.style.width = `${(item.total / maxTotal) * 100}%`;
    const fill = document.createElement('div');
    fill.className = 'facet-bar-fill';
    fill.style.background = item.color;
    fill.style.width = `${(item.filtered / maxTotal) * 100}%`;
    track.append(ghost, fill);

    row.append(head, track);
    wrap.append(row);
  }
}

function renderAtlasLinkedTable(points: AtlasPoint[]) {
  const wrap = el('atlas-linked-table');
  wrap.replaceChildren();
  if (!points.length) {
    const empty = document.createElement('div');
    empty.className = 'empty-state';
    empty.textContent = 'Không có điểm nào khớp bộ lọc chéo hiện tại.';
    wrap.append(empty);
    return;
  }

  const colorBy = select('atlas-color-by').value as AtlasColorBy;
  const table = document.createElement('table');
  const thead = document.createElement('thead');
  const htr = document.createElement('tr');
  for (const label of ['Điểm tri thức', 'Cụm (Cluster)', 'Nguồn / Chiến lược', 'Ngày', 'Thực thể', 'Nội dung']) {
    const th = document.createElement('th');
    th.textContent = label;
    htr.append(th);
  }
  thead.append(htr);

  const tbody = document.createElement('tbody');
  for (const pt of points.slice(0, 60)) {
    const tr = document.createElement('tr');
    tr.style.cursor = 'pointer';
    tr.onclick = () => atlasEngine?.selectPointById(pt.id);

    const tdTitle = document.createElement('td');
    const dot = document.createElement('span');
    dot.style.display = 'inline-block';
    dot.style.width = '8px';
    dot.style.height = '8px';
    dot.style.borderRadius = '50%';
    dot.style.background = atlasColorForPoint(pt, colorBy);
    dot.style.marginRight = '6px';
    const strong = document.createElement('strong');
    strong.textContent = pt.title;
    tdTitle.append(dot, strong);

    const tdCluster = document.createElement('td');
    tdCluster.append(pill(pt.cluster_label, 'accent'));

    const tdStrat = document.createElement('td');
    tdStrat.append(pill(pt.source_type), ' ', pill(pt.strategy));

    const tdDate = document.createElement('td');
    tdDate.textContent = pt.date;

    const tdEnt = document.createElement('td');
    const entWrap = document.createElement('div');
    entWrap.className = 'meta';
    entWrap.style.margin = '0';
    for (const e of pt.entities.slice(0, 3)) entWrap.append(pill(e));
    tdEnt.append(entWrap);

    const tdPreview = document.createElement('td');
    tdPreview.textContent = pt.preview;

    tr.append(tdTitle, tdCluster, tdStrat, tdDate, tdEnt, tdPreview);
    tbody.append(tr);
  }
  table.append(thead, tbody);
  wrap.append(table);
}

function applyAtlasFilters() {
  if (!atlasData) return;
  const allPts = atlasData.points;
  const activePts = allPts.filter((p) => pointMatchesAtlasFilters(p));
  const activeIds = new Set(activePts.map((p) => p.id));

  const searchMatchedIds = new Set<string>();
  if (atlasFilters.query.trim()) {
    const terms = atlasFilters.query.trim().toLowerCase().split(/\s+/).filter(Boolean);
    for (const pt of allPts) {
      const hay = `${pt.title} ${pt.text} ${pt.cluster_label} ${pt.entities.join(' ')}`.toLowerCase();
      if (terms.some((t) => hay.includes(t))) searchMatchedIds.add(pt.id);
    }
  }

  atlasEngine?.setFilterMask(activeIds, searchMatchedIds);
  el('atlas-filter-status').textContent = `${activePts.length} / ${allPts.length} điểm`;

  // Linked cross-filter facets
  const clusterItems = atlasData.clusters.map((c) => ({
    key: c.id,
    label: c.label,
    total: c.count,
    filtered: activePts.filter((p) => p.cluster_id === c.id).length,
    color: clusterColor(c.id),
    active: atlasFilters.clusterId === c.id,
  }));
  renderFacetBars('atlas-facet-clusters', clusterItems, (cid) => {
    atlasFilters.clusterId = atlasFilters.clusterId === Number(cid) ? null : Number(cid);
    applyAtlasFilters();
  });

  const stratItems = atlasData.facets.strategies.map((s) => ({
    key: s.label,
    label: s.label,
    total: s.count,
    filtered: activePts.filter((p) => p.strategy === s.label).length,
    color: s.label === 'document_chunk' ? '#0f766e' : '#2563eb',
    active: atlasFilters.strategy === s.label,
  }));
  renderFacetBars('atlas-facet-strategies', stratItems, (strat) => {
    atlasFilters.strategy = atlasFilters.strategy === String(strat) ? null : String(strat);
    applyAtlasFilters();
  });

  const dateItems = atlasData.facets.dates.slice(-8).map((d) => ({
    key: d.label,
    label: d.label,
    total: d.count,
    filtered: activePts.filter((p) => p.date === d.label).length,
    color: '#d97706',
    active: atlasFilters.date === d.label,
  }));
  renderFacetBars('atlas-facet-dates', dateItems, (dt) => {
    atlasFilters.date = atlasFilters.date === String(dt) ? null : String(dt);
    applyAtlasFilters();
  });

  const entWrap = el('atlas-facet-entities');
  entWrap.replaceChildren();
  for (const e of atlasData.facets.entities) {
    const activeCount = activePts.filter((p) => p.entities.includes(e.label)).length;
    const isAct = atlasFilters.entity === e.label;
    const chip = pill(`${e.label} (${activeCount})`, isAct ? 'accent clickable' : 'clickable');
    chip.onclick = () => {
      atlasFilters.entity = isAct ? null : e.label;
      applyAtlasFilters();
    };
    entWrap.append(chip);
  }

  renderAtlasLinkedTable(activePts);
}

async function refreshEmbeddingAtlas() {
  const canvas = document.getElementById('embedding-atlas-canvas') as HTMLCanvasElement;
  if (!atlasEngine) {
    atlasEngine = new EmbeddingAtlasCanvas(canvas, el('atlas-tooltip'), {
      onSelectPoint: (pt) => renderAtlasInspector(pt),
      onBrushChange: (ids) => {
        atlasFilters.brushIds = ids;
        applyAtlasFilters();
      },
      onClusterClick: (cid) => {
        atlasFilters.clusterId = atlasFilters.clusterId === cid ? null : cid;
        applyAtlasFilters();
      },
    });
  }
  const source = select('kb-source-filter').value;
  atlasData = await request(`/knowledge/atlas?source=${encodeURIComponent(source)}`);
  el('atlas-meta-strip').textContent = `${atlasData!.projection.toUpperCase()} · ${
    atlasData!.used_dense_embeddings ? 'Dense + Lexical' : 'Lexical + Entity'
  } · ${atlasData!.clusters.length} cụm tự động · KDE Contours`;
  atlasEngine.setData(atlasData!);
  applyAtlasFilters();
}

async function refreshKnowledge() {
  await refreshOverview();
  if (activeKbViz === 'atlas') await refreshEmbeddingAtlas();
  else if (activeKbViz === 'graph') await refreshKnowledgeGraph();
  else await refreshKnowledgeTable();
}

