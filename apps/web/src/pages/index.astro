  { key: 'normalize', label: 'Chuẩn hoá' },
  { key: 'chunk', label: 'Chia đoạn' },
  { key: 'enrich', label: 'Trích thực thể' },
  { key: 'index', label: 'Lập chỉ mục' },
];

const EMB_PRESETS: Record<string, { provider: string; base_url: string; model: string }> = {
  ollama: { provider: 'ollama', base_url: 'http://ollama:11434/v1', model: 'nomic-embed-text' },
  openai: { provider: 'openai', base_url: 'https://api.openai.com/v1', model: 'text-embedding-3-small' },
  lmstudio: { provider: 'lmstudio', base_url: 'http://host.docker.internal:1234/v1', model: 'text-embedding-nomic-embed-text-v1.5' },
  openrouter: { provider: 'openrouter', base_url: 'https://openrouter.ai/api/v1', model: 'openai/text-embedding-3-small' },
};

let activeScreen = 'ask';
let devMode = localStorage.getItem(STORAGE_KEYS.devMode) === '1';

let docsCache: any[] = [];
let memoriesCache: any[] = [];
let topEntitiesCache: { id: string; name: string; type: string; mentions: number }[] = [];

// Ask state
let askScope: 'all' | 'documents' | 'memory' = 'all';
let askLastResults: any = null;
let askSelectedKey = '';

// Document SSE watchers
const activeRunWatchers = new Map<string, () => void>();
let currentDetailDoc: { id: string; version: string; filename: string } | null = null;
let reprocessTarget: { id: string; version: string; filename: string } | null = null;

// Explore state
let activeExploreView: 'topics' | 'ego' | 'table' = 'topics';
let topicSource: 'all' | 'documents' | 'memory' = 'all';
let topicDataCache: TopicMapPayload | null = null;
let selectedTopicId: string | null = null;

let egoRenderer: EgoGraphRenderer | null = null;
let egoCurrentEntity = '';
let egoDepth = 1;
let egoPayloadCache: EgoGraphPayload | null = null;

// Dev Atlas
let devAtlasEngine: EmbeddingAtlasCanvas | null = null;

function esc(s: unknown): string {
  return String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function toast(message: string, kind: 'info' | 'ok' | 'err' = 'info') {
  const rack = $('toast-rack');
  while (rack.children.length >= 2) {
    rack.firstElementChild?.remove();
  }
  const item = document.createElement('div');
  item.className = `toast ${kind === 'ok' ? 'is-ok' : kind === 'err' ? 'is-err' : ''}`;
  item.textContent = message;
  rack.appendChild(item);
  setTimeout(() => {
    item.remove();
  }, 2600);
}

function apiBase(): string {
  return ($input('api-endpoint').value || '/api').trim().replace(/\/$/, '');
}

function authHeaders(): Record<string, string> {
  const h: Record<string, string> = {};
  const tenant = $input('tenant-id').value.trim();
  const key = $input('api-key').value.trim();
  if (tenant) h['X-Tenant-ID'] = tenant;
  if (key) {
    if (key.toLowerCase().startsWith('bearer ')) h['Authorization'] = key;
    else h['X-API-Key'] = key;
  }
  return h;
}

async function apiFetch(path: string, init?: RequestInit) {
  const headers = { ...authHeaders(), ...(init?.headers as Record<string, string> | undefined) };
  const res = await fetch(apiBase() + path, { ...init, headers });
  if (!res.ok) {
    let detail = await res.text();
    try {
      const parsed = JSON.parse(detail);
      detail = parsed.detail || detail;
    } catch {}
    throw new Error(detail || `HTTP ${res.status}`);
  }
  if (res.status === 204) return null;
  return res.json();
}

function formatBytes(bytes: number): string {
  if (!bytes) return '0 B';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function formatRelativeTime(isoOrTs: string | number | null | undefined): string {
  if (!isoOrTs) return '';
  const date = typeof isoOrTs === 'number' ? new Date(isoOrTs * 1000) : new Date(isoOrTs);
  if (Number.isNaN(date.getTime())) return String(isoOrTs);
  const diffSec = Math.floor((Date.now() - date.getTime()) / 1000);
  if (diffSec < 60) return 'vừa xong';
  if (diffSec < 3600) return `${Math.floor(diffSec / 60)} phút trước`;
  if (diffSec < 86400) return `${Math.floor(diffSec / 3600)} giờ trước`;
  if (diffSec < 7 * 86400) return `${Math.floor(diffSec / 86400)} ngày trước`;
  return date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function highlightText(text: string, query: string): string {
  const safe = esc(text);
  const terms = Array.from(
    new Set(
      query
        .trim()
        .split(/\s+/)
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .filter((t) => t.length >= 2)
    )
  ).sort((a, b) => b.length - a.length);
  if (!terms.length) return safe;
  const re = new RegExp(`(${terms.join('|')})`, 'gi');
  return safe.replace(re, '<mark>$1</mark>');
}

function relevanceBarsHtml(score: number, maxScore: number): string {
  const ratio = maxScore > 0 ? Math.max(0.15, Math.min(1, score / maxScore)) : 0.5;
  const lit = Math.max(1, Math.min(5, Math.round(ratio * 5)));
  const heights = [5, 7, 9, 11, 14];
  return `
    <span class="relevance-bars" title="Mức độ phù hợp: ${lit}/5" aria-label="Mức độ phù hợp ${lit} trên 5">
      ${heights.map((h, i) => `<span class="relevance-bar ${i < lit ? 'is-lit' : ''}" style="height:${h}px"></span>`).join('')}
    </span>
  `;
}

function defaultPipelineConfigFor(filename: string) {
  const ext = (filename.split('.').pop() || '').toLowerCase();
  const isPlain = ext === 'txt' || ext === 'md' || ext === 'markdown' || ext === 'csv';
  return {
    parser: isPlain ? 'text' : 'docling',
    chunker: 'fixed',
    chunk_size: 1200,
    overlap: 150,
    enrich: true,
  };
}

// ==================== Navigation & Developer Mode ====================

function applyDevModeUI() {
  $input('dev-mode-toggle').checked = devMode;
  $('nav-dev-section').hidden = !devMode;
  $('ask-dev-controls').hidden = !devMode;
  $('mem-opt-strategy-wrap').hidden = !devMode;
  if (!devMode && activeScreen.startsWith('dev-')) {
    switchScreen('ask');
  }
  if (currentDetailDoc) {
    $('doc-detail-dev-bar').hidden = !devMode;
  }
}

function switchScreen(screen: string) {
  activeScreen = screen;
  document.querySelectorAll<HTMLElement>('.main-area > section.screen').forEach((sec) => {
    sec.hidden = sec.id !== `screen-${screen}`;
  });
  document.querySelectorAll<HTMLButtonElement>('.sidebar .nav-item[data-screen]').forEach((btn) => {
    const isAct = btn.dataset.screen === screen;
    btn.classList.toggle('is-active', isAct);
    btn.setAttribute('aria-selected', String(isAct));
  });

  if (screen === 'ask') {
    loadAskIdleData();
  } else if (screen === 'docs') {
    $('docs-list-view').hidden = false;
    $('docs-detail-view').hidden = true;
    currentDetailDoc = null;
    loadDocuments();
  } else if (screen === 'memory') {
    loadMemories();
  } else if (screen === 'explore') {
    loadExploreActiveView();
  } else if (screen === 'settings') {
    loadEmbeddingSettings();
  } else if (screen === 'dev-pipeline') {
    loadDevPipelineRuns();
  } else if (screen === 'dev-atlas') {
    loadDevAtlas();
  } else if (screen === 'dev-eval') {
    loadDevEval();
  }
}

function jumpToEntityEgoGraph(entityId: string) {
  closeDrawer();
  switchScreen('explore');
  switchExploreView('ego');
  loadEgoGraph(entityId, 1);
}

