      meta.className = 'meta';
      meta.append(pill(`${hit.strategy} · ${hit.score.toFixed(4)}`, 'accent'));
      for (const [k, v] of Object.entries(hit.score_breakdown || {})) {
        meta.append(pill(`${k}:${Number(v).toFixed(3)}`));
      }
      row.append(p, meta);
      el('mem-results').append(row);
    }
  });
};

el('btn-refresh-mem').onclick = () => action(refreshMemory);
el('btn-filter-graph').onclick = () => action(refreshMemory);

// Experiments
el('btn-ds-sample').onclick = () => {
  (el('exp-ds-cases') as HTMLTextAreaElement).value = JSON.stringify(
    [
      { query: 'Memory Lab provenance evidence', relevant_substrings: ['Memory Lab'] },
      { query: 'Qdrant Neo4j hybrid retrieval', relevant_substrings: ['Qdrant'] },
    ],
    null,
    2
  );
};

el('exp-dataset-form').onsubmit = (event) => {
  event.preventDefault();
  action(async () => {
    const cases = JSON.parse((el('exp-ds-cases') as HTMLTextAreaElement).value);
    await request('/experiments/datasets', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: input('exp-ds-name').value.trim(),
        description: input('exp-ds-desc').value.trim(),
        cases,
      }),
    });
    await Promise.all([refreshExperiments(), refreshOverview()]);
  });
};

el('exp-run-form').onsubmit = (event) => {
  event.preventDefault();
  action(async () => {
    const target = select('exp-run-target').value;
    await request('/experiments/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: input('exp-run-name').value.trim(),
        dataset_id: select('exp-run-dataset').value,
        target,
        k: Number(input('exp-run-k').value || 5),
        search_mode: select('exp-run-mode').value,
        memory_strategy: target === 'memory' ? select('exp-run-strategy').value : null,
        document_id: input('exp-run-doc-filter').value.trim() || null,
        pipeline_run_id: input('exp-run-run-filter').value.trim() || null,
      }),
    });
    await Promise.all([refreshExperiments(), refreshOverview()]);
  });
};

el('btn-compare').onclick = () => {
  action(async () => {
    const ids = Array.from(document.querySelectorAll<HTMLInputElement>('.report-check:checked')).map((c) => c.value);
    if (!ids.length) throw new Error('Chọn ít nhất 1 báo cáo để so sánh.');
    const comparison = await request(`/experiments/compare?ids=${encodeURIComponent(ids.join(','))}`);
    renderComparison(comparison);
  });
};

el('api').onchange = () => action(refreshAll);
action(refreshAll);
</script>
</body>
</html>
