async function loadDevPipelineRuns() {
  const list = $('dev-runs-list');
  try {
    const [runs, docs] = await Promise.all([apiFetch('/runs'), apiFetch('/documents')]);
    const docNameMap = new Map(docs.map((d: any) => [`${d.id}:${d.version}`, d.filename]));
    if (!runs.length) {
      list.innerHTML = `<div class="card empty-state"><div class="empty-title">Chưa có pipeline run nào</div></div>`;
      return;
    }
    list.innerHTML = runs
      .reverse()
      .map((r: any) => {
        const fname = docNameMap.get(`${r.document_id}:${r.version}`) || `doc:${String(r.document_id || '').slice(0, 8)}`;
        return `
          <div class="card card-pad" style="display:flex;flex-direction:column;gap:8px;">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
              <div>
                <strong>${esc(fname)}</strong>
                <div style="font-family:var(--font-mono);font-size:11.5px;color:var(--ink-muted);">run:${esc(String(r.pipeline_run_id).slice(0, 12))} · ${esc(r.status)} · ${r.chunk_count ?? 0} chunks</div>
              </div>
              <span class="tag-pill">${esc(r.config?.parser || '')}/${esc(r.config?.chunker || '')}</span>
            </div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
              ${['manifest', 'normalized', 'chunks', 'enriched']
                .map((art) => `<button type="button" class="btn btn-sm" data-view-art="${esc(r.pipeline_run_id)}" data-art-name="${art}">${art}</button>`)
                .join('')}
              <button type="button" class="btn btn-sm btn-danger" data-inv-run="${esc(r.pipeline_run_id)}">Invalidate parse</button>
            </div>
          </div>
        `;
      })
      .join('');

    list.querySelectorAll<HTMLButtonElement>('[data-view-art]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const rid = btn.dataset.viewArt!;
        const art = btn.dataset.artName!;
        $('dev-artifact-title').textContent = `${art}.json`;
        $('dev-artifact-meta').textContent = `run:${rid.slice(0, 12)}`;
        try {
          const payload = await apiFetch(`/runs/${encodeURIComponent(rid)}/${art}`);
          $('dev-artifact-viewer').textContent = JSON.stringify(payload, null, 2);
        } catch (err: any) {
          $('dev-artifact-viewer').textContent = `Lỗi: ${err.message}`;
        }
      });
    });

    list.querySelectorAll<HTMLButtonElement>('[data-inv-run]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await apiFetch(`/runs/${encodeURIComponent(btn.dataset.invRun!)}/invalidate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ stages: ['parse'] }),
          });
          toast('Đã invalidate stage parse', 'ok');
          loadDevPipelineRuns();
        } catch (err: any) {
          toast(`Lỗi: ${err.message}`, 'err');
        }
      });
    });
  } catch (err: any) {
    list.innerHTML = `<div class="card empty-state"><div class="empty-title">${esc(err.message)}</div></div>`;
  }
}

async function loadDevAtlas() {
  const source = $select('dev-atlas-source').value;
  try {
    const payload: AtlasPayload = await apiFetch(`/knowledge/atlas?source=${encodeURIComponent(source)}&limit=500`);
    if (!devAtlasEngine) {
      devAtlasEngine = new EmbeddingAtlasCanvas(
        $('dev-atlas-canvas') as HTMLCanvasElement,
        $('dev-atlas-tooltip'),
        (pt) => {
          const box = $('dev-atlas-selected');
          if (!pt) {
            box.hidden = true;
            return;
          }
          box.hidden = false;
          box.innerHTML = `<strong>${esc(pt.title)}</strong> <span class="tag-pill">${esc(pt.cluster_label)}</span><p style="margin:8px 0 0;font-size:13.5px;">${esc(pt.text)}</p>`;
        },
        () => {},
        () => {}
      );
    }
    devAtlasEngine.setData(payload);
  } catch (err: any) {
    toast(`Lỗi tải Embedding Atlas: ${err.message}`, 'err');
  }
}

async function loadDevEval() {
  try {
    const [datasets, reports] = await Promise.all([apiFetch('/experiments/datasets'), apiFetch('/experiments/reports')]);
    const dsSel = $select('eval-run-dataset');
    dsSel.innerHTML = datasets.length
      ? datasets.map((d: any) => `<option value="${esc(d.id)}">${esc(d.name)} (${d.cases?.length || 0} câu hỏi)</option>`).join('')
      : `<option value="">Chưa có dataset</option>`;

    const repWrap = $('eval-reports-list');
    if (!reports.length) {
      repWrap.innerHTML = `<div style="color:var(--ink-muted);font-size:13px;">Chưa có báo cáo đánh giá nào.</div>`;
    } else {
      repWrap.innerHTML = reports
        .map(
          (r: any) => `
          <label style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);gap:10px;">
            <span style="display:flex;align-items:center;gap:8px;">
              <input type="checkbox" class="eval-rep-check" value="${esc(r.id)}" />
              <strong>${esc(r.name)}</strong>
              <span class="tag-pill">${esc(r.target)} · ${esc(r.search_mode)}</span>
            </span>
            <span style="font-family:var(--font-mono);font-size:12px;">Recall@K: ${Number(r.metrics?.recall_at_k || 0).toFixed(3)} · MRR: ${Number(r.metrics?.mrr || 0).toFixed(3)} · nDCG: ${Number(r.metrics?.ndcg_at_k || 0).toFixed(3)}</span>
          </label>
        `
        )
        .join('');
    }
  } catch (err: any) {
    toast(`Lỗi tải Eval: ${err.message}`, 'err');
  }
}

