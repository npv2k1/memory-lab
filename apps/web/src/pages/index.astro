---
import '../styles/app.css';
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Memory Lab — Không gian tri thức cá nhân & nhóm: hỏi đáp trên tài liệu, lưu ký ức theo dòng thời gian và khám phá chủ đề." />
  <title>Memory Lab — Không gian tri thức</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
<div class="app-shell">
  <!-- LEFT SIDEBAR: 4 Task Screens + Settings (+ Developer Mode when enabled) -->
  <aside class="sidebar" aria-label="Điều hướng chính">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">M</div>
      <div>
        <div class="brand-name">Memory Lab</div>
        <div class="brand-sub">Không gian tri thức</div>
      </div>
    </div>

    <nav class="nav-primary" role="tablist" aria-label="Tác vụ chính">
      <button type="button" class="nav-item is-active" data-screen="ask" role="tab" aria-selected="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span>Hỏi</span>
      </button>

      <button type="button" class="nav-item" data-screen="docs" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Tài liệu</span>
        <span class="nav-badge" id="nav-badge-docs">0</span>
      </button>

      <button type="button" class="nav-item" data-screen="memory" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
        <span>Ký ức</span>
        <span class="nav-badge" id="nav-badge-memory">0</span>
      </button>

      <button type="button" class="nav-item" data-screen="explore" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        <span>Khám phá</span>
      </button>
    </nav>

    <!-- Developer Mode Nav (hidden unless enabled in Settings) -->
    <div id="nav-dev-section" hidden>
      <div class="nav-section-label">Nhà phát triển</div>
      <nav class="nav-dev" aria-label="Công cụ nhà phát triển">
        <button type="button" class="nav-item" data-screen="dev-pipeline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span>Pipeline Inspector</span>
        </button>
        <button type="button" class="nav-item" data-screen="dev-atlas">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="8" r="2.2"/><circle cx="17" cy="7" r="2.2"/><circle cx="11" cy="16" r="2.2"/><circle cx="18" cy="17" r="1.8"/><circle cx="6" cy="16" r="1.6"/></svg>
          <span>Embedding Atlas</span>
        </button>
        <button type="button" class="nav-item" data-screen="dev-eval">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          <span>Thử nghiệm &amp; Eval</span>
        </button>
      </nav>
    </div>

    <div class="sidebar-footer">
      <button type="button" class="nav-item" data-screen="settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Cài đặt</span>
      </button>
      <div class="conn-pill" id="conn-status" title="Trạng thái kết nối máy chủ">
        <span class="conn-dot" id="conn-dot"></span>
        <span id="conn-label">Đang kết nối…</span>
      </div>
    </div>
  </aside>

  <!-- MAIN WORKSPACE -->
  <main class="main-area">
    <!-- ==================== SCREEN 1: HỎI (TRANG CHỦ) ==================== -->
    <section id="screen-ask" class="screen">
      <div id="ask-hero" class="ask-hero">
        <h1 class="ask-heading">Bạn muốn tìm gì trong kho tri thức?</h1>
        <p class="ask-sub">Tìm kiếm hợp nhất trên toàn bộ tài liệu và ký ức đã lưu, kèm đoạn trích nguyên văn.</p>

        <form id="ask-form" class="ask-search-box" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="ask-input" class="ask-input" type="search" autocomplete="off" placeholder="Đặt câu hỏi hoặc gõ từ khóa… (VD: quy trình nạp nguyên liệu, cấu hình PostgreSQL)" />
          <span class="kbd-hint">⌘K</span>
          <button type="submit" class="btn btn-primary btn-sm">Tìm kiếm</button>
        </form>

        <div class="ask-filters">
          <button type="button" class="chip is-active" data-ask-scope="all">Tất cả</button>
          <button type="button" class="chip" data-ask-scope="documents">Tài liệu</button>
          <button type="button" class="chip" data-ask-scope="memory">Ký ức</button>

          <select id="ask-time-filter" class="filter-select" aria-label="Lọc theo thời gian">
            <option value="">Thời gian: Tất cả</option>
          </select>

          <select id="ask-doc-filter" class="filter-select" aria-label="Lọc theo tài liệu cụ thể">
            <option value="">Tài liệu: Tất cả</option>
          </select>
        </div>

        <!-- Only visible in Developer Mode -->
        <div id="ask-dev-controls" class="dev-inline-bar" hidden>
          <strong>Chế độ nhà phát triển:</strong>
          <label>
            Tài liệu:
            <select id="ask-dev-doc-mode" class="filter-select">
              <option value="hybrid" selected>Hybrid (RRF)</option>
              <option value="dense">Dense Vector</option>
              <option value="sparse">Sparse BM25</option>
            </select>
          </label>
          <label>
            Ký ức:
            <select id="ask-dev-mem-strategy" class="filter-select">
              <option value="hybrid" selected>Hybrid</option>
              <option value="vector">Vector</option>
              <option value="graph">Graph</option>
              <option value="zero_token">Zero-token</option>
            </select>
          </label>
        </div>
      </div>

      <!-- Idle State: Recent Documents & Recent Memories -->
      <div id="ask-idle">
        <div class="ask-recent-grid">
          <div>
            <div class="recent-col-title">
              <span>Tài liệu gần đây</span>
              <button type="button" class="btn btn-ghost btn-sm" id="btn-goto-docs-from-ask">Xem tất cả →</button>
            </div>
            <div id="ask-recent-docs" class="recent-list"></div>
          </div>
          <div>
            <div class="recent-col-title">
              <span>Ký ức gần đây</span>
              <button type="button" class="btn btn-ghost btn-sm" id="btn-goto-mem-from-ask">Xem tất cả →</button>
            </div>
            <div id="ask-recent-memories" class="recent-list"></div>
          </div>
        </div>
      </div>

      <!-- Search Results -->
      <div id="ask-results-wrap" hidden>
        <div class="ask-results-meta">
          <span id="ask-results-summary"></span>
          <button type="button" class="btn btn-ghost btn-sm" id="btn-clear-ask">Xoá tìm kiếm</button>
        </div>
        <div id="ask-results-list" class="ask-results-list"></div>
      </div>
    </section>

    <!-- ==================== SCREEN 2: TÀI LIỆU ==================== -->
    <section id="screen-docs" class="screen" hidden>
      <!-- Document List View -->
      <div id="docs-list-view">
        <div class="page-header">
          <div>
            <h1 class="page-title">Tài liệu</h1>
            <p class="page-subtitle">Thả tài liệu vào để hệ thống tự động đọc, chia đoạn và lập chỉ mục trong nền.</p>
          </div>
          <button type="button" class="btn btn-primary" id="btn-pick-files">
            + Tải tài liệu lên
          </button>
        </div>

        <div id="doc-dropzone" class="dropzone" tabindex="0" role="button" aria-label="Kéo thả tài liệu vào đây hoặc bấm để chọn tệp">
          <input id="doc-file-input" type="file" multiple hidden accept=".pdf,.docx,.txt,.md,.markdown,.html,.htm,.pptx,.xlsx,.csv" />
          <div class="dropzone-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </div>
          <div class="dropzone-title">Kéo thả tài liệu vào đây, hoặc bấm để chọn tệp</div>
          <div class="dropzone-sub">Hỗ trợ PDF, DOCX, Markdown, TXT, HTML. Tài liệu sẽ tự động được xử lý ngay sau khi tải lên.</div>
        </div>

        <div id="docs-list" class="doc-list"></div>
      </div>

      <!-- Document Reading Detail View -->
      <div id="docs-detail-view" hidden>
        <div class="page-header">
          <div>
            <button type="button" class="btn btn-ghost btn-sm" id="btn-back-docs" style="margin-bottom:8px;padding-left:0;">← Quay lại danh sách tài liệu</button>
            <h1 class="page-title" id="doc-detail-title">Chi tiết tài liệu</h1>
            <p class="page-subtitle" id="doc-detail-meta"></p>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a id="doc-detail-download" class="btn btn-sm" href="#" download>Tải xuống</a>
            <button type="button" class="btn btn-sm" id="doc-detail-reprocess">Xử lý lại</button>
          </div>
        </div>

        <div id="doc-detail-dev-bar" class="dev-inline-bar" style="margin-bottom:18px;" hidden>
          <span id="doc-detail-dev-meta" style="font-family:var(--font-mono);font-size:12px;"></span>
          <button type="button" class="btn btn-sm" id="btn-open-in-inspector">Mở trong Pipeline Inspector</button>
        </div>

        <div class="doc-detail-layout">
          <aside class="doc-detail-aside">
            <div class="aside-card">
              <h3 class="aside-title">Mục lục</h3>
              <div id="doc-detail-toc" class="toc-list"></div>
            </div>
            <div class="aside-card">
              <h3 class="aside-title">Chủ đề chính</h3>
              <div id="doc-detail-topics" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
            </div>
            <div class="aside-card">
              <h3 class="aside-title">Thực thể nổi bật</h3>
              <div id="doc-detail-entities" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
            </div>
          </aside>
          <div id="doc-detail-chunks" class="doc-prose-stream"></div>
        </div>
      </div>
    </section>

    <!-- ==================== SCREEN 3: KÝ ỨC ==================== -->
    <section id="screen-memory" class="screen" hidden>
      <div class="page-header">
        <div>
          <h1 class="page-title">Ký ức</h1>
          <p class="page-subtitle">Ghi chú nhanh thông tin quan trọng và xem lại theo dòng thời gian.</p>
        </div>
      </div>

      <form id="memory-form" class="memory-composer">
        <textarea id="memory-input" class="textarea" rows="3" placeholder="Ghi nhớ điều gì đó… (VD: Cuộc họp với đội vận hành thống nhất chuyển PostgreSQL sang cụm riêng vào tháng 12)" required></textarea>
        <div class="composer-actions">
          <button type="button" class="btn btn-ghost btn-sm" id="btn-toggle-mem-opts">Tuỳ chọn ▾</button>
          <button type="submit" class="btn btn-primary">Lưu ký ức</button>
        </div>

        <div id="memory-options-panel" class="composer-options" hidden>
          <div>
            <label class="field-label" for="mem-opt-session">Phiên (Session)</label>
            <input id="mem-opt-session" class="input" value="default" placeholder="default" />
          </div>
          <div>
            <label class="field-label" for="mem-opt-tags">Nhãn (phân cách bằng dấu phẩy)</label>
            <input id="mem-opt-tags" class="input" placeholder="hạ tầng, quyết định" />
          </div>
          <div>
            <label class="field-label" for="mem-opt-role">Vai trò</label>
            <select id="mem-opt-role" class="select">
              <option value="user" selected>Người dùng</option>
              <option value="assistant">Trợ lý</option>
              <option value="system">Hệ thống</option>
            </select>
          </div>
          <div id="mem-opt-strategy-wrap" hidden>
            <label class="field-label" for="mem-opt-strategy">Chiến lược (Nhà phát triển)</label>
            <select id="mem-opt-strategy" class="select">
              <option value="hybrid" selected>Hybrid</option>
              <option value="vector">Vector</option>
              <option value="graph">Graph</option>
              <option value="zero_token">Zero-token</option>
            </select>
          </div>
        </div>
      </form>

      <div class="memory-filters">
        <input id="mem-filter-q" class="input" style="max-width:280px;" type="search" placeholder="Lọc nhanh ký ức…" />
        <select id="mem-filter-session" class="filter-select">
          <option value="">Phiên: Tất cả</option>
        </select>
        <select id="mem-filter-tag" class="filter-select">
          <option value="">Nhãn: Tất cả</option>
        </select>
        <select id="mem-filter-entity" class="filter-select">
          <option value="">Thực thể: Tất cả</option>
        </select>
        <button type="button" class="btn btn-ghost btn-sm" id="btn-clear-mem-filters" hidden>Xoá bộ lọc</button>
      </div>

      <div id="memory-timeline"></div>
    </section>

    <!-- ==================== SCREEN 4: KHÁM PHÁ ==================== -->
    <section id="screen-explore" class="screen screen-wide" hidden>
      <div class="page-header">
        <div>
          <h1 class="page-title">Khám phá</h1>
          <p class="page-subtitle" id="explore-subtitle">Kho tri thức của bạn đang nói về những chủ đề nào?</p>
        </div>
        <div class="segmented" role="tablist" aria-label="Chế độ khám phá">
          <button type="button" class="is-active" data-explore-view="topics">Bản đồ chủ đề</button>
          <button type="button" data-explore-view="ego">Đồ thị thực thể</button>
          <button type="button" data-explore-view="table">Bảng thực thể</button>
        </div>
      </div>

      <!-- 4a. Bản đồ chủ đề (Treemap) -->
      <div id="explore-view-topics">
        <div class="explore-toolbar">
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button type="button" class="chip is-active" data-topic-source="all">Tất cả nguồn</button>
            <button type="button" class="chip" data-topic-source="documents">Chỉ tài liệu</button>
            <button type="button" class="chip" data-topic-source="memory">Chỉ ký ức</button>
          </div>
          <span id="topic-summary-meta" style="font-size:13px;color:var(--ink-muted);"></span>
        </div>

        <div class="topic-layout">
          <div id="topic-treemap-container" class="treemap-box"></div>
          <aside id="topic-detail-panel" class="topic-detail-panel">
            <div class="empty-state" style="padding:28px 12px;">
              <div class="empty-title">Chọn một chủ đề trên bản đồ</div>
              <p class="empty-sub">Bấm vào một ô chủ đề để xem các đoạn văn tiêu biểu và thực thể chính trong chủ đề đó.</p>
            </div>
          </aside>
        </div>
      </div>

      <!-- 4b. Đồ thị thực thể (Ego Graph) -->
      <div id="explore-view-ego" hidden>
        <div class="ego-controls">
          <form id="ego-search-form" style="display:flex;gap:8px;flex:1;min-width:260px;max-width:440px;">
            <input id="ego-entity-input" class="input" list="ego-entity-datalist" placeholder="Chọn hoặc nhập tên thực thể (VD: PostgreSQL, Alice)…" />
            <datalist id="ego-entity-datalist"></datalist>
            <button type="submit" class="btn btn-primary btn-sm">Xem liên kết</button>
          </form>

          <select id="ego-type-filter" class="filter-select" aria-label="Lọc loại thực thể">
            <option value="">Loại: Tất cả</option>
            <option value="person">Người</option>
            <option value="organization">Tổ chức</option>
            <option value="technology">Công nghệ</option>
            <option value="location">Địa điểm</option>
            <option value="concept">Khái niệm</option>
          </select>

          <button type="button" class="btn btn-sm" id="btn-ego-depth" data-depth="1">Mở rộng bước 2</button>

          <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--ink-secondary);cursor:pointer;">
            <input type="checkbox" id="ego-show-cooccur" />
            <span id="ego-cooccur-label">Hiện liên kết cùng ngữ cảnh (≥ 3 lần)</span>
          </label>
        </div>

        <div id="ego-suggestions" style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:14px;"></div>

        <div class="ego-layout">
          <div class="ego-stage-card">
            <div id="ego-stage" class="ego-stage-inner">
              <div class="empty-state" style="padding-top:160px;">
                <div class="empty-title">Chọn một thực thể để xem mối liên kết xung quanh</div>
                <p class="empty-sub">Đồ thị chỉ tập trung vào tối đa 15 thực thể liên quan trực tiếp để luôn rõ ràng và dễ đọc.</p>
              </div>
            </div>
            <div id="ego-tooltip" class="viz-tooltip" hidden></div>
            <div class="ego-zoom-bar">
              <button type="button" class="btn btn-ghost btn-sm" id="btn-ego-zoom-in" title="Phóng to">+</button>
              <button type="button" class="btn btn-ghost btn-sm" id="btn-ego-zoom-out" title="Thu nhỏ">−</button>
              <button type="button" class="btn btn-ghost btn-sm" id="btn-ego-reset" title="Đặt lại góc nhìn">Đặt lại</button>
            </div>
          </div>

          <aside id="ego-inspector" class="topic-detail-panel">
            <div class="empty-state" style="padding:28px 12px;">
              <div class="empty-title">Thông tin quan hệ</div>
              <p class="empty-sub">Chọn một thực thể phía trên hoặc bấm vào bất kỳ nút nào trên đồ thị để xem chi tiết chứng cứ.</p>
            </div>
          </aside>
        </div>
      </div>

      <!-- 4c. Bảng thực thể -->
      <div id="explore-view-table" hidden>
        <div class="explore-toolbar">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;flex:1;">
            <input id="ent-table-q" class="input" style="max-width:280px;" type="search" placeholder="Tìm thực thể hoặc câu chứng cứ…" />
            <select id="ent-table-type" class="filter-select">
              <option value="">Loại: Tất cả</option>
              <option value="person">Người</option>
              <option value="organization">Tổ chức</option>
              <option value="technology">Công nghệ</option>
              <option value="location">Địa điểm</option>
              <option value="concept">Khái niệm</option>
            </select>
            <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--ink-secondary);cursor:pointer;">
              <input type="checkbox" id="ent-table-clean" checked />
