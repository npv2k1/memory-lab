// 4a. Topic Map
async function loadTopicMap() {
  const stage = $('topic-treemap-container');
  stage.innerHTML = `<div class="empty-state"><div class="empty-title">Đang phân nhóm chủ đề…</div></div>`;
  try {
    const data: TopicMapPayload = await apiFetch(`/topics?source=${encodeURIComponent(topicSource)}`);
    topicDataCache = data;
    $('topic-summary-meta').textContent = `${data.topic_count} chủ đề · ${data.total_items} đoạn nội dung`;
    if (data.topics.length && (!selectedTopicId || !data.topics.some((t) => t.id === selectedTopicId))) {
      selectedTopicId = data.topics[0].id;
    }
    renderTopicTreemap(stage, data, selectedTopicId, (topic) => {
      selectedTopicId = topic.id;
      renderTopicTreemap(stage, data, selectedTopicId, (t) => {
        selectedTopicId = t.id;
        renderTopicDetail(t);
      });
      renderTopicDetail(topic);
    });
    const activeTopic = data.topics.find((t) => t.id === selectedTopicId);
    if (activeTopic) renderTopicDetail(activeTopic);
    else {
      $('topic-detail-panel').innerHTML = `<div class="empty-state" style="padding:28px 12px;"><div class="empty-title">Chưa có chủ đề</div><p class="empty-sub">Hãy thêm tài liệu hoặc ký ức để xem bản đồ chủ đề.</p></div>`;
    }
  } catch (err: any) {
    stage.innerHTML = `<div class="empty-state"><div class="empty-title">Không thể tải bản đồ chủ đề</div><p class="empty-sub">${esc(err.message)}</p></div>`;
  }
}

function renderTopicDetail(topic: TopicCluster) {
  const panel = $('topic-detail-panel');
  const totalItems = Math.max(1, topicDataCache?.total_items || topic.item_count);
  const pct = topic.share_pct ?? Math.round((topic.item_count * 1000) / totalItems) / 10;
  const entsHtml = topic.top_entities.length
    ? topic.top_entities
        .slice(0, 5)
        .map((e: any) => `<button type="button" class="entity-chip" data-jump-entity="${esc(e.id)}">${esc(e.name)} <span style="opacity:.65">(${e.mentions ?? e.count ?? 1})</span></button>`)
        .join('')
    : `<span style="font-size:12.5px;color:var(--ink-muted);">Không có thực thể nổi bật</span>`;

  const chunksHtml = topic.representative_chunks
    .map(
      (c) => `
      <div class="topic-chunk-card">
        <div class="topic-chunk-src">${c.source_type === 'document' ? '📄' : '🧠'} ${esc(c.source_label)}${c.heading ? ' · ' + esc(c.heading) : ''}</div>
        <div class="topic-chunk-text">${esc(c.preview)}</div>
      </div>
    `
    )
    .join('');

  panel.innerHTML = `
    <div>
      <div style="font-size:12px;font-weight:600;color:var(--accent);">${topic.item_count} đoạn (${pct}%) · ${esc(topic.primary_source)}</div>
      <h3 style="margin:4px 0 0;font-size:17px;">${esc(topic.label)}</h3>
    </div>
    <div>
      <div class="aside-title">5 thực thể chính</div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">${entsHtml}</div>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;">
      <div class="aside-title">Đoạn tiêu biểu trong chủ đề</div>
      ${chunksHtml}
    </div>
  `;

  panel.querySelectorAll<HTMLButtonElement>('[data-jump-entity]').forEach((btn) => {
    btn.addEventListener('click', () => jumpToEntityEgoGraph(btn.dataset.jumpEntity!));
  });
}

// 4b. Ego Graph
async function initEgoView() {
  if (!egoRenderer) {
    egoRenderer = new EgoGraphRenderer(
      $('ego-stage'),
      $('ego-tooltip'),
      (entityId) => loadEgoGraph(entityId, 1),
      (node) => renderEgoInspector(egoPayloadCache, node)
    );
  }
  try {
    const tbl = await apiFetch('/knowledge/table?view=entities&min_mentions=1&hide_single_syllable=true&limit=60');
    topEntitiesCache = tbl.rows || [];
    const dl = $('ego-entity-datalist');
    dl.innerHTML = topEntitiesCache.map((e) => `<option value="${esc(e.name)}"></option>`).join('');

    const sugWrap = $('ego-suggestions');
    if (topEntitiesCache.length) {
      sugWrap.innerHTML =
        `<span style="font-size:12.5px;color:var(--ink-muted);">Gợi ý:</span>` +
        topEntitiesCache
          .slice(0, 8)
          .map((e) => `<button type="button" class="entity-chip" data-pick-ego="${esc(e.id)}">${esc(e.name)}</button>`)
          .join('');
      sugWrap.querySelectorAll<HTMLButtonElement>('[data-pick-ego]').forEach((btn) => {
        btn.addEventListener('click', () => loadEgoGraph(btn.dataset.pickEgo!, 1));
      });
    } else {
      sugWrap.innerHTML = '';
    }

    if (egoCurrentEntity) {
      await loadEgoGraph(egoCurrentEntity, egoDepth);
    }
  } catch {}
