async function loadMemories() {
  try {
    memoriesCache = await apiFetch('/memory/records?limit=300');
    $('nav-badge-memory').textContent = String(memoriesCache.length);
    populateMemoryFilterDropdowns();
    renderMemoryTimeline();
  } catch (err: any) {
    $('memory-timeline').innerHTML = `<div class="card empty-state"><div class="empty-title">Không thể tải ký ức</div><p class="empty-sub">${esc(err.message)}</p></div>`;
  }
}

function populateMemoryFilterDropdowns() {
  const sessions = Array.from(new Set(memoriesCache.map((m) => m.session_id).filter(Boolean))).sort();
  const tags = Array.from(new Set(memoriesCache.flatMap((m) => m.tags || []))).sort();
  const entities = Array.from(
    new Map(
      memoriesCache
        .flatMap((m) => m.entities || [])
        .map((e: any) => [e.normalized_name || e.name.toLowerCase(), e.name])
    ).entries()
  ).sort((a, b) => a[1].localeCompare(b[1]));

  const fill = (id: string, defaultLabel: string, opts: [string, string][]) => {
    const sel = $select(id);
    const cur = sel.value;
    sel.innerHTML = `<option value="">${defaultLabel}</option>` + opts.map(([v, l]) => `<option value="${esc(v)}">${esc(l)}</option>`).join('');
    if (cur && opts.some(([v]) => v === cur)) sel.value = cur;
  };

  fill('mem-filter-session', 'Phiên: Tất cả', sessions.map((s) => [s, s]));
  fill('mem-filter-tag', 'Nhãn: Tất cả', tags.map((t) => [t, `#${t}`]));
  fill('mem-filter-entity', 'Thực thể: Tất cả', entities);
}

function timelineBucketLabel(iso: string): { key: string; label: string } {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return { key: '0000', label: 'Trước đó' };
  const now = new Date();
  const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  const itemDay = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
  const diffDays = Math.floor((startToday - itemDay) / 86400000);

  if (diffDays <= 0) return { key: '9999-today', label: 'Hôm nay' };
  if (diffDays === 1) return { key: '9998-yesterday', label: 'Hôm qua' };
  if (diffDays <= 7) return { key: '9997-week', label: 'Tuần này' };
  const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  return { key: ym, label: `Tháng ${d.getMonth() + 1}/${d.getFullYear()}` };
}

function renderMemoryTimeline() {
  const q = $input('mem-filter-q').value.trim().toLowerCase();
  const sess = $select('mem-filter-session').value;
  const tag = $select('mem-filter-tag').value;
  const ent = $select('mem-filter-entity').value;

  const hasFilter = Boolean(q || sess || tag || ent);
  $('btn-clear-mem-filters').hidden = !hasFilter;

  const filtered = memoriesCache.filter((m) => {
    if (sess && m.session_id !== sess) return false;
    if (tag && !(m.tags || []).includes(tag)) return false;
    if (ent && !(m.entities || []).some((e: any) => (e.normalized_name || e.name.toLowerCase()) === ent)) return false;
    if (q) {
      const hay = `${m.content} ${m.session_id} ${(m.tags || []).join(' ')} ${(m.entities || []).map((e: any) => e.name).join(' ')}`.toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  const wrap = $('memory-timeline');
  if (!filtered.length) {
    wrap.innerHTML = `
      <div class="card empty-state">
        <div class="empty-title">${hasFilter ? 'Không có ký ức nào khớp bộ lọc' : 'Chưa có ký ức nào được lưu'}</div>
        <p class="empty-sub">${hasFilter ? 'Hãy thử bỏ bớt bộ lọc để xem lại toàn bộ dòng thời gian.' : 'Hãy gõ một ghi chú vào ô phía trên để bắt đầu xây dựng bộ nhớ của bạn.'}</p>
      </div>
    `;
    return;
  }

  // Group into visual timeline buckets
  const groups = new Map<string, { label: string; items: any[] }>();
  const sorted = [...filtered].sort((a, b) => String(b.timestamp || '').localeCompare(String(a.timestamp || '')));
  for (const rec of sorted) {
    const b = timelineBucketLabel(rec.timestamp);
    if (!groups.has(b.key)) groups.set(b.key, { label: b.label, items: [] });
    groups.get(b.key)!.items.push(rec);
  }

  wrap.innerHTML = Array.from(groups.values())
    .map(
      (g) => `
      <div class="timeline-group">
        <div class="timeline-group-header">
          <span class="timeline-group-title">${esc(g.label)} (${g.items.length})</span>
          <span class="timeline-group-line"></span>
        </div>
        <div class="timeline-items">
          ${g.items
            .map((rec) => {
              const timeStr = new Date(rec.timestamp).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
              const dateStr = String(rec.timestamp || '').slice(0, 10);
              const tagsHtml = (rec.tags || []).map((t: string) => `<span class="tag-pill">#${esc(t)}</span>`).join('');
              const entsHtml = (rec.entities || [])
                .slice(0, 6)
                .map((e: any) => `<button type="button" class="entity-chip" data-jump-entity="${esc(e.normalized_name || e.name)}">${esc(e.name)}</button>`)
                .join('');
              return `
                <article class="memory-card">
                  <div class="memory-card-top">
                    <span>${esc(dateStr)} · ${esc(timeStr)} · Phiên <strong>${esc(rec.session_id || 'default')}</strong></span>
                    <button type="button" class="btn btn-ghost btn-sm" style="color:var(--danger);" data-del-mem="${esc(rec.id)}">Xoá</button>
                  </div>
                  <p class="memory-content">${esc(rec.content)}</p>
                  ${tagsHtml || entsHtml ? `<div class="memory-footer">${tagsHtml}${entsHtml}</div>` : ''}
                </article>
              `;
            })
            .join('')}
        </div>
      </div>
    `
    )
    .join('');

  wrap.querySelectorAll<HTMLButtonElement>('[data-jump-entity]').forEach((btn) => {
    btn.addEventListener('click', () => jumpToEntityEgoGraph(btn.dataset.jumpEntity!));
  });

  wrap.querySelectorAll<HTMLButtonElement>('[data-del-mem]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await apiFetch(`/memory/records/${encodeURIComponent(btn.dataset.delMem!)}`, { method: 'DELETE' });
        toast('Đã xoá ký ức', 'ok');
        await loadMemories();
      } catch (err: any) {
        toast(`Không thể xoá: ${err.message}`, 'err');
      }
    });
  });
}

