// ==================== Helpers & State ====================

const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
const $input = (id: string) => $(id) as HTMLInputElement;
const $select = (id: string) => $(id) as HTMLSelectElement;

