  action(async () => {
    const file = (input('file').files || [])[0];
    if (!file) return;
    const body = new FormData();
    body.append('file', file);
    const docId = input('upload-doc-id').value.trim();
    const qs = docId ? `?document_id=${encodeURIComponent(docId)}` : '';
    await request('/documents' + qs, { method: 'POST', body });
    await Promise.all([refreshDocuments(), refreshOverview()]);
  });
};

el('search').onsubmit = (event) => {
  event.preventDefault();
  action(async () => {
    const params = new URLSearchParams({
      q: input('query').value,
      mode: select('search-mode').value,
    });
    const docId = input('filter-doc-id').value.trim();
    const runId = input('filter-run-id').value.trim();
    if (docId) params.set('document_id', docId);
    if (runId) params.set('pipeline_run_id', runId);

    const hits = await request(`/search?${params.toString()}`);
    el('results').replaceChildren();
    if (!hits.length) el('results').textContent = 'Chưa có kết quả.';
    for (const hit of hits) {
      const row = document.createElement('article');
      const text = document.createElement('p');
      text.textContent = hit.chunk.text;
      const source = document.createElement('a');
      source.href = base() + hit.source_url;
      source.textContent = `Nguồn · score ${hit.score.toFixed(3)} · blocks ${hit.chunk.block_ids.join(', ')}`;
      row.append(text, source);
      if (hit.score_breakdown && Object.keys(hit.score_breakdown).length) {
        const meta = document.createElement('div');
        meta.className = 'meta';
        for (const [k, v] of Object.entries(hit.score_breakdown)) {
          meta.append(pill(`${k}:${Number(v).toFixed(3)}`));
        }
        row.append(meta);
      }
      el('results').append(row);
    }
  });
};

