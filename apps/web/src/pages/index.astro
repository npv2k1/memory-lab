    const doc = detail.document;
    currentDetailDoc = { id: doc.id, version: doc.version, filename: doc.filename };

    $('doc-detail-title').textContent = doc.filename;
    const statusText = detail.latest_run?.status === 'completed' ? '✓ Sẵn sàng' : 'Chưa xử lý xong';
    $('doc-detail-meta').textContent = `${detail.chunks.length} đoạn · ${formatBytes(doc.size_bytes)} · ${statusText}`;

    const dl = $('doc-detail-download') as HTMLAnchorElement;
    dl.href = apiBase() + doc.source_url;
    dl.download = doc.filename;

    // Dev metadata bar
    $('doc-detail-dev-bar').hidden = !devMode;
    $('doc-detail-dev-meta').textContent = `doc:${doc.id.slice(0, 10)} · sha:${doc.content_hash.slice(0, 10)}${detail.latest_run?.pipeline_run_id ? ' · run:' + detail.latest_run.pipeline_run_id.slice(0, 12) : ''}`;

    // TOC
    const tocEl = $('doc-detail-toc');
    if (detail.toc?.length) {
      tocEl.innerHTML = detail.toc
        .map((item: any) => `<button type="button" class="toc-link" data-scroll-chunk="${item.chunk_index}">${esc(item.heading)}</button>`)
        .join('');
      tocEl.querySelectorAll<HTMLButtonElement>('[data-scroll-chunk]').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.getElementById(`doc-chunk-${btn.dataset.scrollChunk}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    } else {
      tocEl.innerHTML = `<span style="font-size:12.5px;color:var(--ink-muted);">Tài liệu không có tiêu đề mục lục.</span>`;
    }

    // Main topics
    const topicsEl = $('doc-detail-topics');
    topicsEl.innerHTML = detail.topics?.length
      ? detail.topics.map((t: string) => `<span class="tag-pill">${esc(t)}</span>`).join('')
      : `<span style="font-size:12.5px;color:var(--ink-muted);">Chưa trích xuất chủ đề.</span>`;

    // Prominent entities
    const entsEl = $('doc-detail-entities');
    entsEl.innerHTML = detail.top_entities?.length
      ? detail.top_entities
          .map((e: any) => `<button type="button" class="entity-chip" data-jump-entity="${esc(e.id)}">${esc(e.name)} <span style="opacity:.65">(${e.mentions})</span></button>`)
          .join('')
      : `<span style="font-size:12.5px;color:var(--ink-muted);">Chưa có thực thể nổi bật.</span>`;
    entsEl.querySelectorAll<HTMLButtonElement>('[data-jump-entity]').forEach((btn) => {
      btn.addEventListener('click', () => jumpToEntityEgoGraph(btn.dataset.jumpEntity!));
    });

    // Readable prose chunks
    const chunksEl = $('doc-detail-chunks');
    if (!detail.chunks?.length) {
      chunksEl.innerHTML = `<div class="card empty-state"><div class="empty-title">Tài liệu chưa có đoạn văn nào</div><p class="empty-sub">Hãy bấm “Xử lý lại” để hệ thống đọc và tách đoạn cho tài liệu này.</p></div>`;
    } else {
      chunksEl.innerHTML = detail.chunks
        .map(
          (c: any) => `
          <article class="prose-chunk" id="doc-chunk-${c.index}">
            <div class="prose-chunk-head">
              <span class="prose-chunk-heading">${esc(c.heading || `Đoạn ${c.index + 1}`)}</span>
              <span>${c.page != null ? `Trang ${c.page}` : `#${c.index + 1}`}</span>
            </div>
            <div class="prose-chunk-body">${esc(c.text)}</div>
          </article>
        `
        )
        .join('');
    }
  } catch (err: any) {
    $('doc-detail-chunks').innerHTML = `<div class="card empty-state"><div class="empty-title">Không thể mở tài liệu</div><p class="empty-sub">${esc(err.message)}</p></div>`;
  }
}

