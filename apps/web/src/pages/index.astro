<!doctype html>
<html lang="vi">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Memory Lab</title></head>
<body>
<main>
<header><small>DOCUMENT PROCESSING · PHASE 1</small><h1>Memory Lab</h1><p>Khám phá tài liệu, pipeline và nguồn chứng cứ.</p></header>
<label>API URL <input id="api" value="http://localhost:8000" /></label>
<section><h2>1. Tài liệu</h2><form id="upload"><input type="file" id="file" accept=".pdf,.docx,.md,.txt,.html" required/><button>Upload</button></form><div id="documents"></div></section>
<section><h2>2. Pipeline inspector</h2><p>Chọn Process trên tài liệu. PDF/DOCX dùng Docling; TXT/Markdown có thể dùng text.</p><label>Parser <select id="parser"><option>docling</option><option>text</option></select></label> <label>Chunker <select id="chunker"><option>fixed</option><option>hybrid</option></select></label><div id="runs"></div><pre id="artifact">Chọn artifact để xem.</pre></section>
<section><h2>3. Retrieval playground</h2><form id="search"><input id="query" placeholder="Nội dung cần tìm…" required/><button>Tìm kiếm</button></form><div id="results"></div></section>
<p id="status" role="status" aria-live="polite"></p>
</main>
<script>
const el = (id: string) => document.getElementById(id)!;
const input = (id: string) => el(id) as HTMLInputElement;
const base = () => input('api').value.replace(/\/$/, '');
async function request(path: string, init?: RequestInit) {
  const response = await fetch(base() + path, init);
  if (!response.ok) throw new Error(await response.text());
  return response.json();
}
async function action(work: () => Promise<void>) {
  el('status').textContent = 'Đang xử lý…';
  try { await work(); el('status').textContent = 'Hoàn tất.'; }
  catch (error) { el('status').textContent = String(error); }
}
function button(label: string, work: () => Promise<void>) {
  const node = document.createElement('button'); node.textContent = label;
  node.onclick = () => action(work); return node;
}
async function refresh() {
  const docs = await request('/documents'); el('documents').replaceChildren();
  for (const doc of docs) {
    const row = document.createElement('article');
    const title = document.createElement('p'); title.textContent = `${doc.filename} · ${doc.version.slice(0, 10)}`; row.append(title);
    row.append(button('Process', async () => {
      await request(`/documents/${doc.id}/versions/${doc.version}/process`, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({parser:input('parser').value,chunker:input('chunker').value})});
      await refresh();
    }));
    el('documents').append(row);
  }
  const runs = await request('/runs'); el('runs').replaceChildren();
  for (const run of runs) {
    const row = document.createElement('article');
    const title = document.createElement('p'); title.textContent = `${run.pipeline_run_id.slice(0, 12)} · ${run.status}`; row.append(title);
    for (const artifact of ['manifest', 'normalized', 'chunks']) row.append(button(artifact, async () => { el('artifact').textContent = JSON.stringify(await request(`/runs/${run.pipeline_run_id}/${artifact}`), null, 2); }));
    el('runs').append(row);
  }
}
el('upload').onsubmit = (event) => { event.preventDefault(); action(async () => {
  const file = (input('file').files || [])[0]; if (!file) return;
  const body = new FormData(); body.append('file',file); await request('/documents',{method:'POST',body}); await refresh();
}); };
el('search').onsubmit = (event) => { event.preventDefault(); action(async () => {
  const hits = await request(`/search?q=${encodeURIComponent(input('query').value)}`); el('results').replaceChildren();
  if (!hits.length) el('results').textContent = 'Chưa có kết quả.';
  for (const hit of hits) {
    const row = document.createElement('article'); const text = document.createElement('p'); text.textContent = hit.chunk.text;
    const source = document.createElement('a'); source.href = base() + hit.source_url; source.textContent = `Nguồn · score ${hit.score.toFixed(3)} · blocks ${hit.chunk.block_ids.join(', ')}`;
    row.append(text,source); el('results').append(row);
  }
}); };
el('api').onchange = () => action(refresh);
action(refresh);
</script>
<style>
:global(body){margin:0;background:#101719;color:#e1e9e5;font:16px/1.6 system-ui}main{max-width:980px;margin:auto;padding:40px 24px}header{margin-bottom:36px}h1{font-size:48px;margin:6px 0}small{color:#91d8b0;letter-spacing:2px}h2{font-size:22px}section{border-top:1px solid #34433e;margin-top:32px;padding-top:16px}input,select,button{font:inherit;padding:9px 12px;border-radius:6px;border:1px solid #465951;background:#1b2822;color:inherit;margin:4px}button{cursor:pointer;background:#a8e9c2;color:#102217}article{padding:14px 0;border-bottom:1px solid #2b3932}a{color:#a8e9c2}pre{overflow:auto;max-height:420px;background:#080e0b;padding:16px;font-size:13px;white-space:pre-wrap}#status{position:sticky;bottom:12px;background:#22372b;padding:12px}form{display:flex;flex-wrap:wrap}#query{flex:1;min-width:150px}@media(max-width:600px){main{padding:20px 12px}h1{font-size:36px}input{max-width:85%}}
</style>
</body></html>
